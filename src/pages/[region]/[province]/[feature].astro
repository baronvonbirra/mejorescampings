---
import Layout from '../../../layouts/Layout.astro';
import CampingCard from '../../../components/CampingCard.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import { getCampings, getFeatures, getLocations, PROVINCES } from '../../../lib/db';

export async function getStaticPaths() {
  const features = await getFeatures();
  const locations = await getLocations();

  const featurePaths: any[] = [];
  for (const prov of PROVINCES) {
    for (const feature of features) {
      featurePaths.push({
        params: {
          region: 'andalucia',
          province: prov.slug,
          feature: feature.slug
        },
        props: { type: 'feature', data: feature }
      });
    }
  }

  const locationPaths = locations.map((loc) => {
    const muniSlug = loc.slug.split('/').pop() || loc.slug;
    return {
      params: {
        region: loc.region || 'andalucia',
        province: loc.province,
        feature: muniSlug
      },
      props: { type: 'location', data: loc }
    };
  });

  return [...featurePaths, ...locationPaths];
}

const { region, province, feature: featureSlug } = Astro.params;
const { type, data } = Astro.props;

const allCampings = await getCampings();
const features = await getFeatures();

const formattedProvince = province ? province.charAt(0).toUpperCase() + province.slice(1) : 'Málaga';

let campings = [];
let pageTitle = '';
let pageHeading = '';
let pageDescription = '';
let currentLabel = '';

if (type === 'feature') {
  const feature = data;
  currentLabel = feature.feature_name;
  const featureKey = feature.key || featureSlug.replace('campings-con-', '').replace('campings-que-admiten-', '').replace('campings-', '');
  campings = allCampings.filter((c) => {
    const sameProv = (c.province_slug || 'malaga').toLowerCase() === (province || 'malaga').toLowerCase();
    return sameProv && c.amenities && c.amenities[featureKey];
  });
  pageTitle = `${feature.feature_name} en ${formattedProvince} | MejoresCampings`;
  pageHeading = `Campings ${feature.feature_name} en ${formattedProvince}`;
  pageDescription = `Mostrando alojamientos de acampada en ${formattedProvince} que disponen de ${feature.feature_name.toLowerCase()}.`;
} else {
  const loc = data;
  currentLabel = loc.municipality;
  const targetSlug = loc.slug; // e.g. "andalucia/malaga/ronda"
  const muniLower = loc.municipality.toLowerCase();

  campings = allCampings.filter((c) => {
    if (c.municipality_slug === targetSlug) return true;
    const addr = (c.address || '').toLowerCase();
    const name = (c.name || '').toLowerCase();
    return addr.includes(muniLower) || name.includes(muniLower);
  });
  pageTitle = `Campings en ${loc.municipality} (${formattedProvince}) | MejoresCampings`;
  pageHeading = `Campings y Glampings en ${loc.municipality}`;
  pageDescription = `Descubre los mejores campings y glampings ubicados en ${loc.municipality} (${formattedProvince}). Información, instalaciones y reserva directa.`;
}

const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": pageHeading,
  "numberOfItems": campings.length,
  "itemListElement": campings.map((c, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": c.name,
    "url": `https://mejorescampings.es/camping/${c.slug}/`
  }))
};
---

<Layout title={pageTitle}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />
  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}${region}/${province}/`} class="hover:text-slate-800 capitalize">{province}</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">{currentLabel}</span>
  </nav>

  <div class="mb-8">
    <div class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-full mb-2">
      Guía Especializada
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      {pageHeading}
    </h1>
    <p class="mt-2 text-slate-600 text-sm sm:text-base max-w-3xl">
      {pageDescription}
    </p>
  </div>

  <!-- Feature Navigation Tabs -->
  <div class="mb-8 flex flex-wrap gap-2 pb-2 border-b border-slate-200">
    <a href={`${import.meta.env.BASE_URL}${region}/${province}/`} class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition">
      Todos
    </a>
    {features.map((f) => (
      <a
        href={`${import.meta.env.BASE_URL}${region}/${province}/${f.slug}/`}
        class={`px-3.5 py-1.5 rounded-lg text-xs transition ${
          f.slug === featureSlug
            ? 'bg-emerald-600 text-white font-bold shadow-xs'
            : 'bg-slate-100 hover:bg-emerald-50 text-slate-700 font-medium'
        }`}
      >
        {f.feature_name}
      </a>
    ))}
  </div>

  <!-- Camping Cards or Empty state -->
  {campings.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {campings.map((camping) => (
        <CampingCard camping={camping} />
      ))}
    </div>
  ) : (
    <div class="bg-white rounded-2xl p-8 text-center border border-slate-200">
      <p class="text-slate-500">No hay campings registrados para "{currentLabel}" en esta categoría aún.</p>
      <a href={`${import.meta.env.BASE_URL}${region}/${province}/`} class="inline-block mt-4 text-sm font-bold text-emerald-600 hover:underline">
        Ver todos los campings de {formattedProvince}
      </a>
    </div>
  )}

  <!-- Mobility Banner (BikesBooking) -->
  <div class="mt-10">
    <AffiliateBanner
      type="mobility"
      url="https://bikesbooking.tpx.lv/HuVioOgE"
      title={`Móvete por ${currentLabel} y la Costa del Sol en Bicicleta o Scooter`}
      description={`Reserva alquiler de bicicletas o motos en ${currentLabel} (${formattedProvince}) para moverte entre campings, playas y senderos.`}
      buttonText="Alquilar Bici o Scooter"
      locationName={currentLabel}
    />
  </div>

  <!-- Featured Activities Banner (Klook) -->
  <div class="mt-8 pt-6 border-t border-slate-200 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-rose-600 uppercase tracking-wider block">Actividades Recomendadas</span>
        <h2 class="text-xl font-extrabold text-slate-900">Qué hacer en {currentLabel} y Provincia de {formattedProvince}</h2>
      </div>
      <a href="https://klook.tpx.lv/q5GFspFV" target="_blank" rel="nofollow sponsored" class="text-xs font-bold text-rose-600 hover:underline">
        Ver en Klook &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <AffiliateCard
        type="activity"
        title={`Experiencias y Excursiones Destacadas en ${currentLabel}`}
        badge="Recomendado"
        location={currentLabel}
        price="Desde €18"
        imageUrl="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/q5GFspFV"
      />
      <AffiliateCard
        type="activity"
        title="Paseos en Barco y Deportes Acuáticos en Costa del Sol"
        badge="Popular"
        location="Málaga"
        price="Desde €15"
        imageUrl="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/q5GFspFV"
      />
      <AffiliateCard
        type="activity"
        title="Rutas Guiadas de Senderismo y Naturaleza en Málaga"
        badge="Aventura"
        location={formattedProvince}
        price="Desde €25"
        imageUrl="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/q5GFspFV"
      />
    </div>
  </div>
</Layout>
