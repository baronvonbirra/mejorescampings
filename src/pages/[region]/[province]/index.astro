---
import Layout from '../../../layouts/Layout.astro';
import CampingCard from '../../../components/CampingCard.astro';
import { getCampings, getFeatures } from '../../../lib/db';

export async function getStaticPaths() {
  return [
    { params: { region: 'andalucia', province: 'malaga' } }
  ];
}

const { region, province } = Astro.params;
const campings = await getCampings();
const features = await getFeatures();

const formattedProvince = province ? province.charAt(0).toUpperCase() + province.slice(1) : 'Málaga';
const formattedRegion = region ? region.charAt(0).toUpperCase() + region.slice(1) : 'Andalucía';
---

<Layout title={`Mejores Campings en ${formattedProvince} (${formattedRegion})`}>
  <!-- Breadcrumb -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <span class="capitalize text-slate-400">{region}</span>
    <span>/</span>
    <span class="capitalize text-slate-800 font-semibold">{province}</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Campings y Glampings en {formattedProvince}
    </h1>
    <p class="mt-2 text-slate-600 text-sm sm:text-base max-w-3xl">
      Selección completa de alojamientos de acampada en {formattedProvince}. Consulta ubicaciones, servicios de piscina, mascotas y enlace directo para reservar al mejor precio.
    </p>
  </div>

  <!-- Feature Quick Filter Bar -->
  <div class="mb-8 flex flex-wrap gap-2 pb-2 border-b border-slate-200">
    <a href={`${import.meta.env.BASE_URL}${region}/${province}/`} class="px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold shadow-xs">
      Todos
    </a>
    {features.map((feat) => (
      <a
        href={`${import.meta.env.BASE_URL}${region}/${province}/${feat.slug}/`}
        class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-medium transition"
      >
        {feat.feature_name}
      </a>
    ))}
  </div>

  <!-- Camping Results Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {campings.map((camping) => (
      <CampingCard camping={camping} />
    ))}
  </div>
</Layout>
