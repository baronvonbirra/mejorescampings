---
import Layout from '../../../layouts/Layout.astro';
import CampingCard from '../../../components/CampingCard.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';
import { getCampings, getFeatures, PROVINCES } from '../../../lib/db';

export async function getStaticPaths() {
  return PROVINCES.map((p) => ({
    params: { region: 'andalucia', province: p.slug }
  }));
}

const { region, province } = Astro.params;
const allCampings = await getCampings();
const campings = allCampings.filter(
  (c) => (c.province_slug || 'malaga').toLowerCase() === (province || 'malaga').toLowerCase()
);
const features = await getFeatures();

const formattedProvince = province ? province.charAt(0).toUpperCase() + province.slice(1) : 'Málaga';
const formattedRegion = region ? region.charAt(0).toUpperCase() + region.slice(1) : 'Andalucía';

const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Los mejores campings en ${formattedProvince}`,
  "numberOfItems": campings.length,
  "itemListElement": campings.map((c, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": c.name,
    "url": `https://mejorescampings.es/camping/${c.slug}/`
  }))
};
---

<Layout title={`Mejores Campings en ${formattedProvince} (${formattedRegion})`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />
  <!-- Breadcrumb -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <span class="capitalize text-slate-400">{region}</span>
    <span>/</span>
    <span class="capitalize text-slate-800 font-semibold">{province}</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Campings y Glampings en {formattedProvince}
    </h1>
    <p class="mt-2 text-slate-600 text-sm sm:text-base max-w-3xl">
      Selección completa de alojamientos de acampada en {formattedProvince}. Consulta ubicaciones, servicios de piscina, mascotas y enlace directo para reservar al mejor precio.
    </p>
  </div>

  <!-- Feature Quick Filter Bar -->
  <div class="mb-8 flex flex-wrap gap-2 pb-2 border-b border-slate-200">
    <a href={`${import.meta.env.BASE_URL}${region}/${province}/`} class="px-3.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold shadow-xs">
      Todos
    </a>
    {features.map((feat) => (
      <a
        href={`${import.meta.env.BASE_URL}${region}/${province}/${feat.slug}/`}
        class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 text-xs font-medium transition"
      >
        {feat.feature_name}
      </a>
    ))}
  </div>

  <!-- Sección de Alquiler de Movilidad (BikesBooking) -->
  <div class="my-6">
    <AffiliateBanner
      type="mobility"
      url="https://bikesbooking.tpx.lv/8A9SZZdt"
      title={`Alquiler de Bicis y Scooters en la Costa del Sol (${formattedProvince})`}
      description={`Recorre las playas, paseos marítimos y senderos de ${formattedProvince} en bicicleta, e-bike o scooter con total comodidad.`}
      buttonText="Reservar Bici o Scooter"
      locationName={formattedProvince}
    />
  </div>

  <!-- Camping Results Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {campings.map((camping) => (
      <CampingCard camping={camping} />
    ))}
  </div>

  <!-- Banner de Actividades Destacadas en la Provincia (Klook) -->
  <div class="mt-12 pt-8 border-t border-slate-200 space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-rose-600 uppercase tracking-wider block">Turismo y Aventura</span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">Actividades e Imprescindibles en {formattedProvince}</h2>
      </div>
      <a href="https://klook.tpx.lv/yBJjXg2w" target="_blank" rel="nofollow sponsored" class="text-xs font-bold text-rose-600 hover:underline">
        Ver catálogo Klook &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <AffiliateCard
        type="activity"
        title="Paseo en Catamarán al Atardecer por la Costa de Málaga"
        badge="Navegación Málaga"
        location="Málaga Puerto"
        price="Desde €15"
        imageUrl="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/yBJjXg2w"
      />
      <AffiliateCard
        type="activity"
        title="Entradas Oficiales y Visita Guiada al Caminito del Rey"
        badge="Más Vendido"
        location="Ardales / El Chorro"
        price="Desde €29"
        imageUrl="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/yBJjXg2w"
      />
      <AffiliateCard
        type="activity"
        title="Excursión a Ronda y Pueblos Blancos desde Málaga"
        badge="Cultura & Paisajes"
        location="Ronda"
        price="Desde €45"
        imageUrl="https://images.unsplash.com/photo-1563299796-b729d0af54a5?auto=format&fit=crop&w=800&q=80"
        url="https://klook.tpx.lv/yBJjXg2w"
      />
    </div>
  </div>
</Layout>
