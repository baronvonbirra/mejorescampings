---
import Layout from '../../layouts/Layout.astro';
import CampingCard from '../../components/CampingCard.astro';
import { getCampings, PROVINCES } from '../../lib/db';
import { PERNOCTA_GUIDES } from '../../lib/pernoctaData';

export async function getStaticPaths() {
  return PROVINCES.map((p) => ({
    params: { provincia: p.slug }
  }));
}

const { provincia } = Astro.params;
const guide = PERNOCTA_GUIDES[provincia?.toLowerCase() || 'malaga'] || PERNOCTA_GUIDES.malaga;

const allCampings = await getCampings();
const provinceCampings = allCampings.filter(
  (c) => (c.province_slug || 'malaga').toLowerCase() === guide.slug
);
const featuredCampings = (provinceCampings.length > 0 ? provinceCampings : allCampings).slice(0, 3);

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.headline,
  "description": guide.metaDesc,
  "author": {
    "@type": "Organization",
    "name": "MejoresCampings",
    "url": "https://mejorescampings.es/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "MejoresCampings"
  },
  "mainEntityOfPage": `https://mejorescampings.es${import.meta.env.BASE_URL}guias/normativa-pernocta-${guide.slug}/`
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": guide.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout title={guide.metaTitle} description={guide.metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5 flex-wrap">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}guias/`} class="hover:text-slate-800 font-medium">Guías</a>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}${guide.slug}/`} class="hover:text-slate-800 capitalize">{guide.provinceName}</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">Normativa de Pernocta</span>
  </nav>

  <!-- Hero Header -->
  <header class="bg-gradient-to-r from-slate-900 via-emerald-950 to-slate-900 text-white rounded-3xl p-8 sm:p-12 mb-8 shadow-xl">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 bg-emerald-500/30 backdrop-blur-md rounded-full text-xs font-bold tracking-wider text-emerald-300 uppercase">
        Guía Legal Actualizada 2026
      </span>
      <span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-bold text-slate-200">
        Provincia de {guide.provinceName}
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight max-w-3xl">
      {guide.headline}
    </h1>
    <p class="mt-3 text-slate-300 text-xs sm:text-sm max-w-2xl leading-relaxed">
      {guide.summaryText}
    </p>
  </header>

  <!-- Inter-Province Guides Bar -->
  <div class="mb-8 p-4 bg-white border border-slate-200 rounded-2xl shadow-2xs">
    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2">
      📍 Ver Normativa de Pernocta en otra provincia de Andalucía:
    </span>
    <div class="flex flex-wrap gap-2">
      {PROVINCES.map((p) => {
        const isCurrent = p.slug === guide.slug;
        return (
          <a
            href={`${import.meta.env.BASE_URL}guias/normativa-pernocta-${p.slug}/`}
            class={`px-3 py-1.5 rounded-lg text-xs font-bold transition ${
              isCurrent
                ? 'bg-emerald-600 text-white shadow-xs'
                : 'bg-slate-100 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700'
            }`}
          >
            {p.name}
          </a>
        );
      })}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <!-- Article Content -->
    <article class="lg:col-span-2 space-y-8 text-slate-800 text-sm sm:text-base leading-relaxed">

      <!-- Summary Box -->
      <div class="p-5 bg-emerald-50 border border-emerald-200/90 rounded-2xl space-y-2">
        <h2 class="font-extrabold text-emerald-950 text-base flex items-center gap-2">
          💡 Regla de Oro para Rutas Camper en {guide.provinceName}
        </h2>
        <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
          {guide.goldenRule}
        </p>
      </div>

      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          1. ¿Es legal la Acampada Libre en {guide.provinceName}?
        </h2>
        <p>
          {guide.introText}
        </p>
        <p>
          Las sanciones por acampada ilegal en parajes naturales o zonas costeras no autorizadas oscilan entre <strong>{guide.sanctionsRange}</strong> según la gravedad de la infracción y la figura de protección ambiental.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          2. Pernoctar vs Acampar: La Instrucción PROT 2023/14 de la DGT
        </h2>
        <p>
          Para clarificar la legislación nacional, la Dirección General de Tráfico (DGT) emitió la instrucción donde se establece expresamente que:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
          <div class="p-4 bg-white border border-emerald-200 rounded-2xl shadow-2xs space-y-1">
            <span class="font-extrabold text-emerald-800 text-sm block">✅ Pernoctar (PERMITIDO)</span>
            <p class="text-xs text-slate-600 leading-relaxed">
              Dormir dentro del vehículo en una plaza de aparcamiento pública permitida. El vehículo no sobresale en volumen, no emite ruidos ni fluidos y mantiene sus ruedas apoyadas sobre el suelo.
            </p>
          </div>
          <div class="p-4 bg-white border border-rose-200 rounded-2xl shadow-2xs space-y-1">
            <span class="font-extrabold text-rose-800 text-sm block">❌ Acampar (PROHIBIDO)</span>
            <p class="text-xs text-slate-600 leading-relaxed">
              Sacar mesas, sillas, desplegar el toldo lateral, poner calzos de nivelación o verter aguas residuales en la vía pública o espacios naturales.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          3. Áreas Especiales: Costa y Espacios Naturales Protegidos de {guide.provinceName}
        </h2>
        <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
          <div>
            <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-1.5">
              <span>🌊</span> Regulación Costera / Fluvial
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              {guide.coastalRules}
            </p>
          </div>
          <div class="pt-3 border-t border-slate-200">
            <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-1.5">
              <span>🌲</span> Normativa en Parques Naturales
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              {guide.naturalParksRules}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Espacios protegidos emblemáticos -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          4. Principales Espacios Protegidos en {guide.provinceName}
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {guide.naturalParksList.map((park) => (
            <li class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl text-xs sm:text-sm font-semibold text-slate-800">
              <span class="text-emerald-600">🌲</span> {park}
            </li>
          ))}
        </ul>
      </section>

      <!-- Section 5: Consejos Prácticos -->
      <section class="space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          5. Recomendaciones Prácticas para Tu Ruta en {guide.provinceName}
        </h2>
        <div class="space-y-2">
          {guide.localTips.map((tip) => (
            <div class="flex items-start gap-2.5 p-3.5 bg-amber-50/60 border border-amber-200/80 rounded-xl text-xs sm:text-sm text-slate-800">
              <span class="text-amber-600 shrink-0 font-bold">📌</span>
              <span>{tip}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQs Section -->
      <section class="pt-6 border-t border-slate-200 space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Preguntas Frecuentes sobre Pernocta en {guide.provinceName}</h2>
        <div class="space-y-3">
          {guide.faqs.map((faq) => (
            <details class="bg-slate-50 border border-slate-200 rounded-xl p-4 group">
              <summary class="font-bold text-slate-900 cursor-pointer flex justify-between items-center text-sm">
                <span>{faq.question}</span>
                <span class="text-emerald-600 group-open:rotate-180">&darr;</span>
              </summary>
              <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-2">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA Section -->
      <div class="p-6 bg-gradient-to-r from-emerald-800 to-teal-900 text-white rounded-2xl shadow-md text-center space-y-3">
        <h3 class="text-lg font-extrabold">¿Buscas parcelas o áreas camper verificadas en {guide.provinceName}?</h3>
        <p class="text-xs sm:text-sm text-emerald-100 max-w-xl mx-auto">
          Explora la lista completa de campings oficiales con toma eléctrica, piscinas y todos los servicios en {guide.provinceName}.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}${guide.slug}/`}
          class="inline-block px-6 py-3 rounded-xl bg-white text-emerald-950 font-black text-sm hover:bg-emerald-100 transition shadow-md"
        >
          Ver Campings Verificados en {guide.provinceName} &rarr;
        </a>
      </div>
    </article>

    <!-- Sidebar with recommended campings -->
    <aside class="space-y-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs space-y-4 sticky top-24">
        <h3 class="font-bold text-base text-slate-900 border-b border-slate-100 pb-2 flex items-center justify-between">
          <span>Campings en {guide.provinceName}</span>
          <span class="text-xs font-semibold text-emerald-600">{provinceCampings.length} en total</span>
        </h3>
        <div class="space-y-4">
          {featuredCampings.map((camping) => (
            <CampingCard camping={camping} />
          ))}
        </div>
        <a
          href={`${import.meta.env.BASE_URL}${guide.slug}/`}
          class="block text-center text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 py-2.5 rounded-xl border border-emerald-200 transition"
        >
          Ver todos los campings de {guide.provinceName} &rarr;
        </a>
      </div>
    </aside>
  </div>
</Layout>
