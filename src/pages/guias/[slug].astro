---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((guia) => ({
    params: { slug: guia.slug },
    props: { guia }
  }));
}

const { guia } = Astro.props;
const { Content, headings } = await guia.render();

// Fallback hero image if heroImage is not specified in frontmatter
const defaultHero = "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80";
const heroUrl = guia.data.heroImage || defaultHero;
const heroAlt = guia.data.heroImageAlt || guia.data.title;

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guia.data.title,
  "description": guia.data.description,
  "image": heroUrl,
  "datePublished": guia.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": guia.data.author || "Redacción MejoresCampings"
  },
  "publisher": {
    "@type": "Organization",
    "name": "MejoresCampings.es",
    "url": "https://mejorescampings.es"
  }
};

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Dynamic Contextual Affiliate Callout Config based on guide slug
const affiliateConfigs: Record<string, { title: string; description: string; buttonText: string; url: string; badge: string }> = {
  'normativa-pernocta-autocaravanas-andalucia': {
    title: '¿Necesitas alquilar furgoneta o coche para esta ruta?',
    description: 'Compara precios en el aeropuerto de Málaga y reserva al mejor precio con EconomyBookings.',
    buttonText: 'Compara precios en el aeropuerto de Málaga',
    url: 'https://economybookings.tpx.lv/ex1AUP2Z',
    badge: 'Alquiler Recomendado'
  },
  'guia-camping-con-ninos-consejos-equipamiento': {
    title: 'Pases con descuento para parques acuáticos y monumentos en Andalucía',
    description: 'Reserva pases familiares, entradas a parques temáticos y excursiones guiadas con Tiqets y Klook.',
    buttonText: 'Ver pases con descuento en Tiqets',
    url: 'https://tiqets.tpx.lv/l4s4f69n',
    badge: 'Actividades Familiares'
  },
  'ruta-5-dias-camper-costa-del-sol': {
    title: 'Viaja asegurado en tu ruta por Andalucía',
    description: 'Protege tu viaje camper o de carretera con cobertura médica y asistencia en viaje integral de EKTA.',
    buttonText: 'Contratar Seguro EKTA',
    url: 'https://ektatraveling.tpx.lv/V0yP4yJF',
    badge: 'Seguro de Viaje'
  },
  'diferencias-glamping-bungalow-camping-tradicional': {
    title: 'Recomendaciones de experiencias exclusivas cerca de zonas de Glamping',
    description: 'Disfruta de tours privados, veleros y catas exclusivas en Andalucía reservando con Tiqets.',
    buttonText: 'Explorar experiencias en Tiqets',
    url: 'https://tiqets.tpx.lv/l4s4f69n',
    badge: 'Experiencias Glamping'
  }
};

const guideAffiliate = affiliateConfigs[guia.slug];
---

<Layout title={guia.data.title} description={guia.data.description} image={heroUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />

  <article class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumb Navigation -->
    <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5 flex-wrap">
      <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
      <span>/</span>
      <a href={`${import.meta.env.BASE_URL}guias/`} class="hover:text-slate-800">Guías</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{guia.data.title}</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4 border-b border-slate-200 pb-6">
      <div class="flex items-center gap-3 text-xs text-slate-500">
        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-full uppercase tracking-wider">
          Guía Editorial
        </span>
        <time datetime={guia.data.pubDate.toISOString()}>
          {guia.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>• Por {guia.data.author}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {guia.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 font-medium">
        {guia.data.description}
      </p>

      <!-- Responsive Hero Image Banner -->
      <div class="relative w-full h-80 sm:h-96 rounded-2xl overflow-hidden mt-6 shadow-md">
        <img
          src={heroUrl}
          alt={heroAlt}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </header>

    <!-- Table of Contents (TOC) -->
    {tocHeadings.length > 0 && (
      <div class="p-5 bg-slate-50 border border-slate-200 rounded-2xl shadow-2xs">
        <h2 class="text-sm font-extrabold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
          <span>📌</span> Índice de contenidos
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm font-medium text-slate-700">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'ml-4 list-disc text-slate-600' : ''}>
              <a href={`#${h.slug}`} class="hover:text-emerald-600 hover:underline transition">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Main Markdown Content -->
    <div class="prose prose-slate max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-100 prose-h2:pb-2 prose-h3:text-xl prose-a:text-emerald-600 hover:prose-a:underline prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-emerald-50/60 prose-blockquote:p-4 prose-blockquote:rounded-r-xl prose-blockquote:text-slate-800 prose-blockquote:not-italic shadow-none">
      <Content />
    </div>

    <!-- Contextual Affiliate Callout Component -->
    {guideAffiliate && (
      <AffiliateCallout
        title={guideAffiliate.title}
        description={guideAffiliate.description}
        buttonText={guideAffiliate.buttonText}
        url={guideAffiliate.url}
        badge={guideAffiliate.badge}
      />
    )}

    <!-- Related Internal Links & Hubs -->
    <section class="mt-12 pt-8 border-t border-slate-200 space-y-4">
      <h3 class="text-lg font-extrabold text-slate-900">Encuentra tu próximo alojamiento en Andalucía</h3>
      <div class="flex flex-wrap gap-2 text-xs font-semibold">
        <a href={`${import.meta.env.BASE_URL}malaga/`} class="px-3.5 py-2 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl hover:bg-emerald-100 transition">
          Campings en Málaga &rarr;
        </a>
        <a href={`${import.meta.env.BASE_URL}cadiz/`} class="px-3.5 py-2 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl hover:bg-emerald-100 transition">
          Campings en Cádiz &rarr;
        </a>
        <a href={`${import.meta.env.BASE_URL}campings-con-mascotas/`} class="px-3.5 py-2 bg-slate-100 border border-slate-200 text-slate-800 rounded-xl hover:bg-slate-200 transition">
          Campings con Mascotas &rarr;
        </a>
        <a href={`${import.meta.env.BASE_URL}glamping/`} class="px-3.5 py-2 bg-slate-100 border border-slate-200 text-slate-800 rounded-xl hover:bg-slate-200 transition">
          Glampings Recomendados &rarr;
        </a>
      </div>
    </section>
  </article>
</Layout>
