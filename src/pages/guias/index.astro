---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import { PROVINCES } from '../../lib/db';
import { PERNOCTA_GUIDES } from '../../lib/pernoctaData';

const editorialGuias = (await getCollection('guias'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const metaTitle = "Guías de Pernocta y Artículos Editoriales de Camping en Andalucía | MejoresCampings";
const metaDesc = "Sección de guías oficiales de pernocta, acampada libre y legislación camper en Almería, Cádiz, Córdoba, Granada, Huelva, Jaén, Málaga y Sevilla.";

const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Guías de Pernocta y Acampada por Provincia en Andalucía",
  "numberOfItems": PROVINCES.length,
  "itemListElement": PROVINCES.map((p, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": `Guía de Pernocta en ${p.name}`,
    "url": `https://mejorescampings.es/guias/normativa-pernocta-${p.slug}/`
  }))
};
---

<Layout title={metaTitle} description={metaDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />

  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5 flex-wrap">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">Guías de Pernocta</span>
  </nav>

  <!-- Hero Header -->
  <header class="bg-gradient-to-r from-slate-900 via-emerald-950 to-slate-900 text-white rounded-3xl p-8 sm:p-12 mb-10 shadow-xl relative overflow-hidden">
    <div class="relative z-10 max-w-3xl">
      <span class="inline-block px-3 py-1 bg-emerald-500/30 backdrop-blur-md rounded-full text-xs font-bold tracking-wider text-emerald-300 mb-3 uppercase">
        Sección Oficial de Guías 2026
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
        Guías de Pernocta y Acampada por Provincia
      </h1>
      <p class="mt-4 text-slate-300 text-xs sm:text-base leading-relaxed">
        Consulta la normativa legal actualizada para furgoneta camper, autocaravana y acampada en cada una de las 8 provincias de Andalucía. Ley de Costas, Parques Naturales y consejos locales.
      </p>
    </div>
  </header>

  <!-- Editorial Pillar Guides Section -->
  {editorialGuias.length > 0 && (
    <section class="mb-12">
      <div class="mb-6">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider block">Artículos Destacados</span>
        <h2 class="text-2xl font-bold text-slate-900">Guías Prácticas y Consejos de Acampada</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {editorialGuias.map((g) => {
          const defaultHero = "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80";
          const heroUrl = g.data.heroImage || defaultHero;
          const heroAlt = g.data.heroImageAlt || g.data.title;
          return (
            <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition flex flex-col justify-between overflow-hidden group">
              <div>
                <div class="relative h-44 w-full overflow-hidden bg-slate-100">
                  <img
                    src={heroUrl}
                    alt={heroAlt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3">
                    <span class="text-[10px] font-bold text-emerald-950 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full uppercase tracking-wider shadow-2xs">
                      Consejos & Rutas
                    </span>
                  </div>
                </div>
                <div class="p-6 space-y-3">
                  <h3 class="font-extrabold text-slate-900 text-lg group-hover:text-emerald-600 transition leading-snug">
                    {g.data.title}
                  </h3>
                  <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                    {g.data.description}
                  </p>
                </div>
              </div>
              <div class="p-4 bg-slate-50 border-t border-slate-100">
                <a
                  href={`${import.meta.env.BASE_URL}guias/${g.slug}/`}
                  class="block w-full text-center py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white font-bold text-xs shadow-xs transition"
                >
                  Leer Guía Completa &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- General Legal Summary Card -->
  <div class="mb-10 p-6 bg-gradient-to-br from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl shadow-2xs space-y-3">
    <div class="flex items-center gap-2 text-emerald-900 font-extrabold text-base">
      <span>💡</span>
      <h2>Marco Legal Común en Andalucía (Decreto 26/2018 y DGT PROT 2023/14)</h2>
    </div>
    <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
      En toda la comunidad autónoma de Andalucía, la <strong>acampada libre está prohibida</strong> fuera de establecimientos turísticos autorizados. No obstante, según la Instrucción PROT 2023/14 de la DGT, es totalmente legal <strong>pernoctar</strong> dentro de tu vehículo camper o autocaravana debidamente estacionado en plazas públicas, siempre que no sobresalga de su perímetro ni despliegues elementos exteriores (toldos, calzos, mesas o patas de nivelación).
    </p>
  </div>

  <!-- Affiliate Banner: Car Rental for Roadtrips -->
  <div class="mb-10">
    <AffiliateBanner
      type="car_rental"
      url="https://getrentacar.tpx.lv/3TC3lyZZ"
      locationName="Andalucía"
    />
  </div>

  <!-- Classified Guides Grid by Province -->
  <section class="mb-12">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-slate-900">Selecciona tu Provincia de Destino</h2>
      <p class="text-xs sm:text-sm text-slate-500">Accede a la guía detallada de leyes, multas, parques naturales y campings verificados</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {PROVINCES.map((p) => {
        const guideData = PERNOCTA_GUIDES[p.slug] || PERNOCTA_GUIDES.malaga;
        const defaultHero = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80";
        const pernoctaHero = guideData.heroImage || p.image || defaultHero;
        return (
          <div class="bg-white rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md transition flex flex-col justify-between overflow-hidden group">
            <div>
              <div class="relative h-40 w-full overflow-hidden bg-slate-100">
                <img
                  src={pernoctaHero}
                  alt={`Normativa de pernocta camper en ${p.name}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
                  <span class="text-xs font-extrabold text-emerald-950 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-full shadow-2xs">
                    {p.name}
                  </span>
                  <span class="text-[10px] font-bold text-white bg-black/50 backdrop-blur-xs px-2 py-0.5 rounded-full uppercase tracking-wider">
                    Pernocta
                  </span>
                </div>
              </div>

              <div class="p-5 space-y-3">
                <h3 class="font-extrabold text-slate-900 text-base group-hover:text-emerald-600 transition leading-snug">
                  Guía de Pernocta en {p.name}
                </h3>

                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                  {guideData.summaryText}
                </p>

                <div class="pt-1">
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">
                    Espacios destacados:
                  </span>
                  <div class="flex flex-wrap gap-1">
                    {guideData.naturalParksList.slice(0, 2).map((park) => (
                      <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px] font-medium">
                        {park}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="p-4 bg-slate-50 border-t border-slate-100 flex flex-col gap-2">
              <a
                href={`${import.meta.env.BASE_URL}guias/normativa-pernocta-${p.slug}/`}
                class="w-full text-center py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition"
              >
                Ver Guía Pernocta {p.name} &rarr;
              </a>
              <a
                href={`${import.meta.env.BASE_URL}${p.slug}/`}
                class="w-full text-center py-1.5 text-[11px] font-medium text-slate-600 hover:text-emerald-700 transition"
              >
                Campings en {p.name}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
