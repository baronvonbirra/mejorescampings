---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mapa Interactivo de Campings en Andalucía | MejoresCampings" description="Explora en el mapa todos los campings y glampings verificados en Andalucía. Filtra por ubicación y encuentra tu próximo destino camper.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>

  <div class="space-y-4">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 text-white p-6 rounded-2xl shadow-md border border-slate-800">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2.5 py-0.5 bg-emerald-500/20 text-emerald-400 font-bold text-[10px] rounded-full uppercase tracking-wider">
            Mapa Interactivo
          </span>
          <span class="text-slate-400 text-xs">OpenStreetMap</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Mapa de Campings en Andalucía</h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl">
          Haz clic en cualquier marcador para ver detalles, fotos y enlace directo a la ficha del camping.
        </p>
      </div>
      <a href={import.meta.env.BASE_URL} class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition text-center shrink-0">
        &larr; Volver al Inicio
      </a>
    </div>

    <!-- Map Container Container -->
    <div class="relative w-full h-[calc(100vh-250px)] min-h-[500px] rounded-2xl overflow-hidden border border-slate-200 shadow-lg z-10">
      <div id="map-container" class="w-full h-full bg-slate-100"></div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      if (typeof L === 'undefined') {
        await new Promise((resolve) => {
          const interval = setInterval(() => {
            if (typeof L !== 'undefined') {
              clearInterval(interval);
              resolve();
            }
          }, 50);
        });
      }

      const map = L.map('map-container').setView([37.3826, -4.5000], 8);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);

      try {
        const baseUrl = document.querySelector('base')?.getAttribute('href') || '/';
        const res = await fetch(`${baseUrl}api/campings-geo.json`);
        if (!res.ok) return;
        const campings = await res.json();

        campings.forEach((c) => {
          if (c.latitude && c.longitude) {
            const popupContent = `
              <div class="p-1 max-w-[200px]">
                <img src="${c.main_image}" alt="${c.name}" class="w-full h-24 object-cover rounded-md mb-2 shadow-xs"/>
                <h4 class="font-bold text-xs text-slate-900 mb-0.5 line-clamp-1">${c.name}</h4>
                <p class="text-[11px] text-slate-500 mb-2 capitalize">${c.municipality}</p>
                <a href="${baseUrl}camping/${c.slug}/" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg block text-center font-bold transition shadow-2xs">Ver Ficha &rarr;</a>
              </div>
            `;
            L.marker([c.latitude, c.longitude]).addTo(map).bindPopup(popupContent);
          }
        });
      } catch (err) {
        console.error('Failed to load campings geo JSON:', err);
      }
    });
  </script>
</Layout>
