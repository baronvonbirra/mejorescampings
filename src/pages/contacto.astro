---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto y Soporte | MejoresCampings.es" description="Ponte en contacto con el equipo de MejoresCampings.es para consultas, sugerencias de nuevos campings o soporte sobre la plataforma.">
  <div class="max-w-4xl mx-auto space-y-8">
    <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5">
      <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">Contacto</span>
    </nav>

    <header class="border-b border-slate-200 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Contacto y Soporte</h1>
      <p class="text-lg text-slate-600 mt-2 font-medium">¿Tienes alguna duda, sugerencia o deseas dar de alta tu alojamiento? Escríbenos.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-6">
        <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-2xl">
          <h3 class="font-bold text-emerald-950 text-base mb-2">Correo Electrónico</h3>
          <p class="text-xs text-emerald-900 mb-3">Atención directa para usuarios y propietarios de campings.</p>
          <a href="mailto:contacto@mejorescampings.es" class="text-sm font-extrabold text-emerald-700 hover:underline">contacto@mejorescampings.es</a>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-5 rounded-2xl space-y-2 text-xs text-slate-600">
          <h4 class="font-bold text-slate-900 text-sm">Horario de Atención</h4>
          <p>Lunes a Viernes: 09:00 - 18:00 h</p>
          <p>Tiempo medio de respuesta: menos de 24 horas laborables.</p>
        </div>
      </div>

      <div class="md:col-span-2 bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Gracias por tu mensaje. Nos pondremos en contacto a la mayor brevedad.');">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nombre Completo</label>
            <input type="text" required placeholder="Tu nombre" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Correo Electrónico</label>
            <input type="email" required placeholder="tu@email.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Asunto</label>
            <select class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
              <option>Consulta General</option>
              <option>Sugerir o Registrar un Camping</option>
              <option>Actualizar Datos de Alojamiento</option>
              <option>Prensa y Colaboraciones</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mensaje</label>
            <textarea rows="4" required placeholder="Escribe aquí tu consulta..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
          </div>

          <button type="submit" class="w-full py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow transition">
            Enviar Mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
