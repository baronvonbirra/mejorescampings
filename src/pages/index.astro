---
import Layout from '../layouts/Layout.astro';
import CampingCard from '../components/CampingCard.astro';
import { getCampings, getFeatures, PROVINCES } from '../lib/db';

const getEnvVar = (key: string): string => {
  try {
    if (typeof process !== 'undefined' && process?.env && process.env[key]) {
      return process.env[key];
    }
  } catch (e) {}
  try {
    if (typeof import.meta !== 'undefined' && import.meta?.env && import.meta.env[key]) {
      return import.meta.env[key];
    }
  } catch (e) {}
  return '';
};

const sanitizeSupabaseUrl = (url?: string): string => {
  if (!url) return '';
  let cleaned = url.trim();
  cleaned = cleaned.replace(/\/+$/, '');
  cleaned = cleaned.replace(/\/rest\/v1\/?$/i, '');
  cleaned = cleaned.replace(/\/+$/, '');
  return cleaned;
};

const rawSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || getEnvVar('PUBLIC_SUPABASE_URL') || getEnvVar('SUPABASE_URL') || '';
const rawSupabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || getEnvVar('PUBLIC_SUPABASE_ANON_KEY') || getEnvVar('SUPABASE_ANON_KEY') || '';

const supabaseUrl = sanitizeSupabaseUrl(rawSupabaseUrl);
const supabaseKey = rawSupabaseKey.trim();

const allCampings = await getCampings();
const features = await getFeatures();

// Filter active campsites and sort globally: promoted first, then by rating
const activeCampings = allCampings.filter((c) => c.is_active && c.status !== 'disabled');
const sortedCampings = [...activeCampings].sort((a, b) => {
  if (a.is_promoted && !b.is_promoted) return -1;
  if (!a.is_promoted && b.is_promoted) return 1;
  return (b.rating || 0) - (a.rating || 0);
});

const categories = [
  { name: 'Glamping de Lujo', slug: 'glamping', icon: '⛺', desc: 'Tiendas bell y domos con el máximo confort.' },
  { name: 'Mascotas Permitidas', slug: 'campings-con-mascotas', icon: '🐾', desc: 'Campings pet-friendly para viajar con tu perro.' },
  { name: 'Cerca de la Playa', slug: 'campings-playa', icon: '🏖️', desc: 'A poca distancia del mar y calas vírgenes.' },
  { name: 'Familiares con Piscina', slug: 'campings-con-piscina', icon: '🏊', desc: 'Con animación infantil y parques acuáticos.' }
];

const provinceCounts = PROVINCES.map((p) => {
  const count = allCampings.filter((c) => (c.province_slug || 'malaga').toLowerCase() === p.slug).length;
  return { ...p, count };
});
---

<Layout title="MejoresCampings | Guía de Campings, Glampings y Pernocta en Andalucía (8 Provincias)">
  <div id="homepage-supabase-config" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} class="hidden"></div>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-emerald-800 via-teal-900 to-slate-900 text-white rounded-3xl p-8 sm:p-12 mb-10 shadow-xl relative overflow-hidden">
    <div class="relative z-10 max-w-3xl">
      <span class="inline-block px-3 py-1 bg-emerald-500/30 backdrop-blur-md rounded-full text-xs font-bold tracking-wider text-emerald-200 mb-4 uppercase">
        Guía Andalucía 2026 • 8 Provincias
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
        Encuentra tu camping ideal en Andalucía
      </h1>
      <p class="mt-4 text-emerald-100 text-sm sm:text-base leading-relaxed">
        Descubre más de 200 campings y glampings verificados, junto con la normativa oficial de pernocta camper en Almería, Cádiz, Córdoba, Granada, Huelva, Jaén, Málaga y Sevilla.
      </p>
    </div>
  </section>

  <!-- Explora por Provincia de Andalucía (8 Provincias Grid) -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Explora los Campings de Andalucía por Provincia</h2>
        <p class="text-xs sm:text-sm text-slate-500">Haz clic en tu provincia de destino para ver alojamientos, mapa y filtros</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {provinceCounts.map((p) => (
        <a
          href={`${import.meta.env.BASE_URL}${p.slug}/`}
          class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs hover:shadow-md hover:border-emerald-500 transition group relative overflow-hidden flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-extrabold text-slate-900 text-lg group-hover:text-emerald-600 transition">{p.name}</h3>
              <span class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                {p.count} campings
              </span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">{p.description}</p>
            <div class="flex flex-wrap gap-1 text-[10px] mb-3">
              {p.highlights.map((h) => (
                <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md font-medium">{h}</span>
              ))}
            </div>
          </div>
          <div class="pt-2 border-t border-slate-100 text-[11px] font-bold text-emerald-700 flex items-center justify-between">
            <span>Ver alojamientos</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Filtros por Estilo de Viaje y Servicios (Green Container Box) -->
  <section class="bg-gradient-to-br from-emerald-900 via-emerald-800 to-teal-900 text-white rounded-3xl p-6 sm:p-8 mb-12 shadow-lg border border-emerald-700/50">
    <!-- Container Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-emerald-700/60">
      <div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight">Estilos de Viaje y Guías por Provincia</h2>
        <p class="text-xs sm:text-sm text-emerald-200 mt-1">Encuentra tu camping ideal o consulta la normativa legal de pernocta en tu provincia</p>
      </div>
      <a
        href={`${import.meta.env.BASE_URL}guias/`}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-100 bg-emerald-950/60 hover:bg-emerald-950 border border-emerald-500/40 px-3.5 py-2 rounded-xl transition self-start sm:self-auto shrink-0 shadow-xs"
      >
        🚐 Guías Pernocta (8 Provincias) &rarr;
      </a>
    </div>

    <!-- Group 1: Estilos de Viaje -->
    <div class="mb-6">
      <h3 class="text-xs font-bold text-emerald-300 uppercase tracking-wider mb-3 flex items-center gap-1.5">
        <span>🗺️</span> Estilos de Viaje & Guías
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a
          href={`${import.meta.env.BASE_URL}guias/`}
          class="bg-white/10 hover:bg-white/20 backdrop-blur-xs p-3.5 rounded-xl border border-white/15 transition group flex items-start gap-3"
        >
          <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform">🚐</span>
          <div>
            <h4 class="font-bold text-white text-xs sm:text-sm leading-snug group-hover:text-emerald-200 transition">Guías de Pernocta Camper</h4>
            <p class="text-[11px] text-emerald-100/80 mt-0.5 leading-tight">Normativa legal en las 8 provincias de Andalucía.</p>
          </div>
        </a>

        <a
          href={`${import.meta.env.BASE_URL}campings-familiares/`}
          class="bg-white/10 hover:bg-white/20 backdrop-blur-xs p-3.5 rounded-xl border border-white/15 transition group flex items-start gap-3"
        >
          <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform">👨‍👩‍👧‍👦</span>
          <div>
            <h4 class="font-bold text-white text-xs sm:text-sm leading-snug group-hover:text-emerald-200 transition">Plan Familiar</h4>
            <p class="text-[11px] text-emerald-100/80 mt-0.5 leading-tight">Piscina, parque infantil y animación.</p>
          </div>
        </a>

        <a
          href={`${import.meta.env.BASE_URL}campings-playa/`}
          class="bg-white/10 hover:bg-white/20 backdrop-blur-xs p-3.5 rounded-xl border border-white/15 transition group flex items-start gap-3"
        >
          <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform">🏖️</span>
          <div>
            <h4 class="font-bold text-white text-xs sm:text-sm leading-snug group-hover:text-emerald-200 transition">Cerca de la Playa</h4>
            <p class="text-[11px] text-emerald-100/80 mt-0.5 leading-tight">A pocos pasos de Tarifa, Cabo de Gata y Costa del Sol.</p>
          </div>
        </a>

        <a
          href={`${import.meta.env.BASE_URL}glamping/`}
          class="bg-white/10 hover:bg-white/20 backdrop-blur-xs p-3.5 rounded-xl border border-white/15 transition group flex items-start gap-3"
        >
          <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform">⛺</span>
          <div>
            <h4 class="font-bold text-white text-xs sm:text-sm leading-snug group-hover:text-emerald-200 transition">Glamping Romántico</h4>
            <p class="text-[11px] text-emerald-100/80 mt-0.5 leading-tight">Cabañas de madera y domos exclusivos.</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Group 2: Servicios e Instalaciones Popular -->
    <div>
      <h3 class="text-xs font-bold text-emerald-300 uppercase tracking-wider mb-3 flex items-center gap-1.5">
        <span>⚡</span> Servicios e Instalaciones
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {categories.map((cat) => (
          <a
            href={`${import.meta.env.BASE_URL}${cat.slug}/`}
            class="bg-white/10 hover:bg-white/20 backdrop-blur-xs p-3.5 rounded-xl border border-white/15 transition group flex items-start gap-3"
          >
            <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform">{cat.icon}</span>
            <div>
              <h4 class="font-bold text-white text-xs sm:text-sm leading-snug group-hover:text-emerald-200 transition">{cat.name}</h4>
              <p class="text-[11px] text-emerald-100/80 mt-0.5 leading-tight">{cat.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Curated Mix of Top Featured / Admin Promoted Campings -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Selección de Campings Destacados en Andalucía</h2>
        <p class="text-xs sm:text-sm text-slate-500">Alojamiento de alta calidad y promocionados en las 8 provincias</p>
      </div>
      <button
        id="btn-show-all-campings"
        class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 cursor-pointer border border-emerald-200 bg-emerald-50 px-3 py-1.5 rounded-xl hover:bg-emerald-100 transition"
      >
        Ver Campings &rarr;
      </button>
    </div>

    <!-- Render all available camping cards cleanly, showing top 6 initially -->
    <div id="featured-campings-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedCampings.map((camping, index) => (
        <div
          class="camping-card-wrapper flex flex-col"
          data-slug={camping.slug}
          data-ssg-promoted={camping.is_promoted ? "true" : "false"}
          data-ssg-active={camping.is_active ? "true" : "false"}
          style={index < 6 ? 'display: flex;' : 'display: none;'}
        >
          <CampingCard camping={camping} />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    // Client-side dynamic sync with Supabase DB & Local Admin Overrides
    (function () {
      function cleanUrl(url) {
        if (!url) return '';
        let c = url.trim();
        c = c.replace(/\/+$/, '');
        c = c.replace(/\/rest\/v1\/?$/i, '');
        c = c.replace(/\/+$/, '');
        return c;
      }

      function getSupabaseCredentials() {
        try {
          const stored = localStorage.getItem('mejorescampings_supabase_config');
          if (stored) {
            const parsed = JSON.parse(stored);
            if (parsed.url && parsed.key) {
              return { url: cleanUrl(parsed.url), key: parsed.key.trim() };
            }
          }
        } catch (e) {}

        const el = document.getElementById('homepage-supabase-config');
        if (el) {
          const envUrl = el.getAttribute('data-supabase-url');
          const envKey = el.getAttribute('data-supabase-key');
          if (envUrl && envKey) {
            return { url: cleanUrl(envUrl), key: envKey.trim() };
          }
        }
        return null;
      }

      async function fetchLiveSupabaseData() {
        const creds = getSupabaseCredentials();
        if (!creds?.url || !creds?.key) return {};

        try {
          const res = await fetch(`${creds.url}/rest/v1/campings?select=slug,is_promoted,is_active,status,image_url,image_urls`, {
            headers: {
              'apikey': creds.key,
              'Authorization': `Bearer ${creds.key}`
            }
          });
          if (!res.ok) return {};
          const data = await res.json();
          const supaMap = {};
          if (Array.isArray(data)) {
            data.forEach((item) => {
              if (item.slug) supaMap[item.slug] = item;
            });
          }
          return supaMap;
        } catch (e) {
          console.warn('Live Supabase sync fetch failed:', e);
          return {};
        }
      }

      async function applyDynamicUpdatesToHomePage() {
        try {
          let overrides = {};
          try {
            const raw = localStorage.getItem('mejorescampings_admin_overrides');
            if (raw) overrides = JSON.parse(raw);
          } catch (e) {}

          const liveSupaMap = await fetchLiveSupabaseData();
          const grid = document.getElementById('featured-campings-grid');
          if (!grid) return;

          const cardWrappers = Array.from(grid.querySelectorAll('.camping-card-wrapper'));

          cardWrappers.forEach((wrapper) => {
            const slug = wrapper.getAttribute('data-slug');
            if (!slug) return;

            const ssgPromoted = wrapper.getAttribute('data-ssg-promoted') === 'true';
            const ssgActive = wrapper.getAttribute('data-ssg-active') !== 'false';

            const ov = overrides[slug];
            const supaRecord = liveSupaMap[slug];

            // Resolve active status
            let isActive = ssgActive;
            if (supaRecord && typeof supaRecord.is_active === 'boolean') {
              isActive = supaRecord.is_active && supaRecord.status !== 'disabled';
            }
            if (ov) {
              if (ov.is_active === false || ov.status === 'disabled') isActive = false;
              if (ov.is_active === true || ov.status === 'active') isActive = true;
            }

            if (!isActive) {
              wrapper.style.display = 'none';
              wrapper.setAttribute('data-hidden-admin', 'true');
            } else {
              wrapper.removeAttribute('data-hidden-admin');
            }

            // Resolve promoted status
            let isPromoted = ssgPromoted;
            if (supaRecord && typeof supaRecord.is_promoted === 'boolean') {
              isPromoted = supaRecord.is_promoted;
            }
            if (ov && typeof ov.is_promoted === 'boolean') {
              isPromoted = ov.is_promoted;
            }
            wrapper.setAttribute('data-is-promoted', isPromoted ? 'true' : 'false');

            // Toggle visual badge on card
            const badge = wrapper.querySelector('.camping-promoted-badge');
            if (badge) {
              if (isPromoted) {
                badge.classList.remove('hidden');
              } else {
                badge.classList.add('hidden');
              }
            }

            // Resolve image URL
            const finalImgUrl = ov?.image_url || supaRecord?.image_url;
            if (finalImgUrl) {
              const img = wrapper.querySelector('.camping-card-img') || wrapper.querySelector('img');
              if (img && img.src !== finalImgUrl) {
                img.src = finalImgUrl;
              }
            }
          });

          // Re-sort active wrappers: Promoted first, then standard
          const activeWrappers = Array.from(grid.querySelectorAll('.camping-card-wrapper:not([data-hidden-admin="true"])'));
          activeWrappers.sort((a, b) => {
            const isPromA = a.getAttribute('data-is-promoted') === 'true';
            const isPromB = b.getAttribute('data-is-promoted') === 'true';
            if (isPromA && !isPromB) return -1;
            if (!isPromA && isPromB) return 1;
            return 0;
          });

          // Re-append sorted cards in order and re-evaluate top 6 display logic
          activeWrappers.forEach((wrapper, index) => {
            grid.appendChild(wrapper);
            if (!window.__showAllCampingsClicked) {
              wrapper.style.display = index < 6 ? 'flex' : 'none';
            } else {
              wrapper.style.display = 'flex';
            }
          });
        } catch (e) {
          console.warn('Error applying dynamic updates on homepage:', e);
        }
      }

      function showAllCampings() {
        window.__showAllCampingsClicked = true;
        const grid = document.getElementById('featured-campings-grid');
        if (!grid) return;

        const cardNodes = Array.from(grid.children);
        cardNodes.forEach((node) => {
          if (node.getAttribute('data-hidden-admin') !== 'true') {
            node.style.display = 'flex';
          }
        });

        const btn = document.getElementById('btn-show-all-campings');
        if (btn) btn.style.display = 'none';
      }

      function init() {
        applyDynamicUpdatesToHomePage();
        document.getElementById('btn-show-all-campings')?.addEventListener('click', showAllCampings);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</Layout>
