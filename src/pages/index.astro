---
import Layout from '../layouts/Layout.astro';
import CampingCard from '../components/CampingCard.astro';
import { getCampings, getFeatures } from '../lib/db';

const campings = await getCampings();
const features = await getFeatures();
---

<Layout title="CampBase | Mejores Campings y Glampings en Málaga">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-emerald-800 to-teal-900 text-white rounded-3xl p-8 sm:p-12 mb-10 shadow-xl relative overflow-hidden">
    <div class="relative z-10 max-w-2xl">
      <span class="inline-block px-3 py-1 bg-emerald-500/30 backdrop-blur-md rounded-full text-xs font-semibold tracking-wider text-emerald-200 mb-4 uppercase">
        Guía Especializada Málaga 2026
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
        Encuentra tu Camping ideal en Málaga
      </h1>
      <p class="mt-4 text-emerald-100 text-sm sm:text-base leading-relaxed">
        Descubre los mejores campings y glampings de la provincia de Málaga. Instalaciones verificadas con piscinas, animación infantil y entorno familiar.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/andalucia/malaga" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-sm transition shadow-md">
          Ver Campings en Málaga
        </a>
        <a href="/andalucia/malaga/glamping" class="px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl text-sm backdrop-blur-md transition">
          Ver Glampings
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Feature Filter Pills -->
  <section class="mb-10">
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-3">Filtrar por característica popular</h2>
    <div class="flex flex-wrap gap-2">
      {features.map((feat) => (
        <a
          href={`/andalucia/malaga/${feat.slug}`}
          class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-sm font-medium hover:border-emerald-500 hover:text-emerald-600 shadow-xs transition"
        >
          {feat.feature_name}
        </a>
      ))}
    </div>
  </section>

  <!-- Camping Grid -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-slate-900">Campings destacados en Málaga</h2>
      <a href="/andalucia/malaga" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">
        Ver todos ({campings.length}) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {campings.map((camping) => (
        <CampingCard camping={camping} />
      ))}
    </div>
  </section>
</Layout>
