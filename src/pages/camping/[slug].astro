---
import Layout from '../../layouts/Layout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import FeatureBadges from '../../components/FeatureBadges.astro';
import { getCampings, getCampingBySlug } from '../../lib/db';

export async function getStaticPaths() {
  const campings = await getCampings();
  return campings.map((camping) => ({
    params: { slug: camping.slug },
    props: { camping }
  }));
}

const { slug } = Astro.params;
const { camping } = Astro.props;

const priceLabels: Record<number, string> = { 1: 'Económico (€)', 2: 'Estándar (€€)', 3: 'Confort (€€€)', 4: 'Lujo / Premium (€€€€)' };
---

<Layout title={`${camping.name} | Camping en Málaga`}>
  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5">
    <a href="/" class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <a href={`/${camping.municipality_slug}`} class="hover:text-slate-800 capitalize">Málaga</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">{camping.name}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Left Column -->
    <div class="lg:col-span-2 space-y-6">
      <ImageGallery images={camping.image_urls} name={camping.name} />

      <div>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">
            {camping.municipality_slug.split('/').pop()?.toUpperCase()}
          </span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
            Categoría: {priceLabels[camping.price_tier] || 'Estándar'}
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-1 tracking-tight">
          {camping.name}
        </h1>

        <p class="text-xs sm:text-sm text-slate-500 mt-2 flex items-center gap-1">
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {camping.address}
        </p>
      </div>

      <hr class="border-slate-200" />

      <!-- Description -->
      <div>
        <h2 class="text-lg font-bold text-slate-900 mb-2">Descripción del Alojamiento</h2>
        <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-line">
          {camping.description}
        </p>
      </div>

      <!-- Services & Amenities -->
      <div>
        <h2 class="text-lg font-bold text-slate-900 mb-2">Servicios e Instalaciones</h2>
        <FeatureBadges amenities={camping.amenities} />
      </div>

      <!-- Map Embed / Info Block -->
      <div class="bg-slate-100 rounded-2xl p-4 border border-slate-200 text-xs text-slate-600 flex items-center justify-between">
        <div>
          <span class="font-bold text-slate-800 block">Coordenadas GPS</span>
          <span>Lat: {camping.lat}, Lng: {camping.lng}</span>
        </div>
        <a
          href={`https://maps.google.com/?q=${camping.lat},${camping.lng}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-slate-700 font-semibold hover:bg-slate-50 transition"
        >
          Abrir en Google Maps
        </a>
      </div>
    </div>

    <!-- Right Sidebar Desktop CTA -->
    <div class="hidden lg:block">
      <div class="sticky top-24 bg-white border border-slate-200 rounded-2xl p-6 shadow-md space-y-4">
        <h3 class="font-bold text-lg text-slate-900">Reserva tu estancia</h3>
        <p class="text-xs text-slate-500">Consulta disponibilidad y mejores ofertas directamente para {camping.name}.</p>

        {camping.affiliate_url ? (
          <a
            href={camping.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition"
          >
            Ver Disponibilidad y Precios
          </a>
        ) : (
          /* Fallback Adsense / B2B Slot when affiliate_url is missing */
          <div data-testid="adsense-fallback" class="bg-amber-50 border-2 border-dashed border-amber-300 rounded-xl p-4 text-center">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-700 block mb-1">Publicidad / Google AdSense</span>
            <p class="text-xs text-amber-800">Anuncio recomendado de alojamientos similares en Málaga</p>
            {camping.official_url && (
              <a href={camping.official_url} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-emerald-700 underline font-semibold">
                Visitar web oficial
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Bottom CTA Bar -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 z-50 shadow-2xl flex items-center justify-between">
    <div>
      <span class="text-xs font-bold text-slate-900 block truncate max-w-[180px]">{camping.name}</span>
      <span class="text-[10px] text-emerald-600 font-semibold">{priceLabels[camping.price_tier] || '€€'}</span>
    </div>

    {camping.affiliate_url ? (
      <a
        href={camping.affiliate_url}
        target="_blank"
        rel="noopener noreferrer"
        class="py-2.5 px-5 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow-md"
      >
        Ver Disponibilidad
      </a>
    ) : (
      <div data-testid="adsense-fallback-mobile" class="bg-amber-100 text-amber-900 text-xs px-3 py-1.5 rounded-lg font-bold">
        AdSense Active
      </div>
    )}
  </div>
</Layout>
