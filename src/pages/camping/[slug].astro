---
import Layout from '../../layouts/Layout.astro';
import HeroGallery from '../../components/HeroGallery.astro';
import CampingBadges from '../../components/CampingBadges.astro';
import EditorialBadge from '../../components/EditorialBadge.astro';
import CampingHighlights from '../../components/CampingHighlights.astro';
import AiDescription from '../../components/AiDescription.astro';
import StickyCtaMobile from '../../components/StickyCtaMobile.astro';
import CampingCard from '../../components/CampingCard.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import { getCampings, PROVINCES } from '../../lib/db';

export async function getStaticPaths() {
  const campings = await getCampings();
  return campings.map((camping) => ({
    params: { slug: camping.slug },
    props: { camping }
  }));
}

const getEnvVar = (key: string): string => {
  try {
    if (typeof process !== 'undefined' && process?.env && process.env[key]) {
      return process.env[key];
    }
  } catch (e) {}
  try {
    if (typeof import.meta !== 'undefined' && import.meta?.env && import.meta.env[key]) {
      return import.meta.env[key];
    }
  } catch (e) {}
  return '';
};

const sanitizeSupabaseUrl = (url?: string): string => {
  if (!url) return '';
  let cleaned = url.trim();
  cleaned = cleaned.replace(/\/+$/, '');
  cleaned = cleaned.replace(/\/rest\/v1\/?$/i, '');
  cleaned = cleaned.replace(/\/+$/, '');
  return cleaned;
};

const rawSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || getEnvVar('PUBLIC_SUPABASE_URL') || getEnvVar('SUPABASE_URL') || '';
const rawSupabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || getEnvVar('PUBLIC_SUPABASE_ANON_KEY') || getEnvVar('SUPABASE_ANON_KEY') || '';

const supabaseUrl = sanitizeSupabaseUrl(rawSupabaseUrl);
const supabaseKey = rawSupabaseKey.trim();

const { slug } = Astro.params;
const { camping } = Astro.props;

const allCampings = await getCampings();

const provinceSlug = (camping.province_slug || 'malaga').toLowerCase();
const provInfo = PROVINCES.find((p) => p.slug === provinceSlug);
const provinceName = provInfo ? provInfo.name : provinceSlug.charAt(0).toUpperCase() + provinceSlug.slice(1);

const municipalitySlug = (camping.municipality_slug || '').split('/').pop() || provinceSlug;
const municipalityName = municipalitySlug.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());

// Neighboring province suggestion logic
const neighborProvinces: Record<string, string[]> = {
  almeria: ['granada'],
  cadiz: ['malaga', 'sevilla', 'huelva'],
  cordoba: ['sevilla', 'jaen', 'malaga', 'granada'],
  granada: ['malaga', 'almeria', 'jaen', 'cordoba'],
  huelva: ['cadiz', 'sevilla'],
  jaen: ['granada', 'cordoba'],
  malaga: ['cadiz', 'granada', 'sevilla', 'cordoba'],
  sevilla: ['cadiz', 'huelva', 'cordoba', 'malaga']
};
const neighborSlug = (neighborProvinces[provinceSlug] || ['malaga'])[0];
const neighborInfo = PROVINCES.find((p) => p.slug === neighborSlug);
const neighborName = neighborInfo ? neighborInfo.name : neighborSlug.charAt(0).toUpperCase() + neighborSlug.slice(1);
const neighborCampings = allCampings.filter((c) => (c.province_slug || 'malaga').toLowerCase() === neighborSlug).slice(0, 3);

// Open-Meteo Real-time Weather Forecast (3-day build-time fetch)
interface WeatherDay {
  date: string;
  tempMax: number;
  tempMin: number;
  weatherCode: number;
}
let weatherForecast: WeatherDay[] = [];

try {
  const weatherRes = await fetch(
    `https://api.open-meteo.com/v1/forecast?latitude=${camping.lat}&longitude=${camping.lng}&daily=temperature_2m_max,temperature_2m_min,weathercode&timezone=auto`
  );
  if (weatherRes.ok) {
    const data = await weatherRes.json();
    const dates = data.daily?.time || [];
    const maxs = data.daily?.temperature_2m_max || [];
    const mins = data.daily?.temperature_2m_min || [];
    const codes = data.daily?.weathercode || [];
    weatherForecast = dates.slice(0, 3).map((d: string, i: number) => ({
      date: new Date(d).toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' }),
      tempMax: Math.round(maxs[i] ?? 22),
      tempMin: Math.round(mins[i] ?? 14),
      weatherCode: codes[i] ?? 0
    }));
  }
} catch (e) {
  // Graceful fallback weather forecast
  weatherForecast = [
    { date: 'Hoy', tempMax: 24, tempMin: 15, weatherCode: 0 },
    { date: 'Mañana', tempMax: 25, tempMin: 16, weatherCode: 1 },
    { date: 'Pasado mañana', tempMax: 23, tempMin: 14, weatherCode: 2 }
  ];
}

const weatherIcons: Record<number, string> = {
  0: '☀️', 1: '🌤️', 2: '⛅', 3: '☁️', 45: '🌫️', 61: '🌧️', 80: '🌦️'
};

// Internal Linking Engine: Filter related campings by same municipality, same province/category, and neighbor province
const sameMunicipalityCampings = allCampings.filter(
  (c) => c.slug !== camping.slug && ((c.municipality_slug || '').split('/').pop() === municipalitySlug)
).slice(0, 3);

const sameProvinceCampings = allCampings.filter(
  (c) => c.slug !== camping.slug && (c.province_slug || 'malaga').toLowerCase() === provinceSlug
);

const featuredAmenityKey = camping.amenities?.piscina ? 'piscina' : camping.amenities?.mascotas ? 'mascotas' : camping.amenities?.playa ? 'playa' : 'glamping';
const featuredAmenityName = featuredAmenityKey === 'piscina' ? 'con piscina' : featuredAmenityKey === 'mascotas' ? 'que admiten mascotas' : featuredAmenityKey === 'playa' ? 'cerca de la playa' : 'con bungalows y glamping';

const sameProvinceCategoryCampings = sameProvinceCampings.filter(
  (c) => c.amenities && c.amenities[featuredAmenityKey]
).slice(0, 3);

// Dynamic Meta Metadata & OG Image
const metaTitle = camping.meta_title || `${camping.name} en ${municipalityName} (Málaga) | MejoresCampings`;
const metaDesc = camping.meta_description || `Reserva y opiniones de ${camping.name} en ${municipalityName}. Servicios, mascotas, fotos y disponibilidad.`;
const ogImage = camping.image_urls && camping.image_urls.length > 0 ? camping.image_urls[0] : camping.image_url;

// Schema.org Structured Data
const jsonLdCampground = {
  "@context": "https://schema.org",
  "@type": "Campground",
  "name": camping.name,
  "description": camping.ai_description || camping.description,
  "url": `https://mejorescampings.es${import.meta.env.BASE_URL}camping/${camping.slug}/`,
  "image": camping.image_urls,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": camping.address,
    "addressLocality": municipalityName,
    "addressRegion": "Málaga",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": camping.lat,
    "longitude": camping.lng
  }
};

const jsonLdFaq = camping.faqs_json && camping.faqs_json.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": camping.faqs_json.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<Layout title={metaTitle} description={metaDesc} image={ogImage}>
  <div id="campsite-detail-supabase-config" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} class="hidden"></div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdCampground)} />
  {jsonLdFaq && <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />}

  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5 flex-wrap">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <span class="text-slate-400">Andalucía</span>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}${provinceSlug}/`} class="hover:text-slate-800 capitalize">{provinceName}</a>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}${provinceSlug}/${municipalitySlug}/`} class="hover:text-slate-800">{municipalityName}</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">{camping.name}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Left Column -->
    <div class="lg:col-span-2 space-y-6">

      <!-- H1 Title & Location Header -->
      <div>
        <div class="flex items-center justify-between flex-wrap gap-2">
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-wide">
            {municipalityName}
          </span>
          <div class="flex items-center gap-2">
            <!-- Aggregate Rating Badge -->
            <span class="inline-flex items-center gap-1 text-xs font-extrabold px-2.5 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-200 shadow-2xs">
              <span class="text-amber-500">★</span> {camping.rating || 4.3} / 5
              <span class="text-slate-400 font-normal">({camping.review_count || 120} opiniones)</span>
            </span>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
              Categoría: {camping.price_tier === 1 ? 'Económico (€)' : camping.price_tier === 3 ? 'Confort (€€€)' : 'Estándar (€€)'}
            </span>
          </div>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-1 tracking-tight">
          {camping.name}
        </h1>

        <p class="text-xs sm:text-sm text-slate-500 mt-2 flex items-center gap-1">
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {camping.address}
        </p>

        <!-- Editorial Badges & Quote -->
        <EditorialBadge
          badges={camping.editorial_badges || camping.editorial_tags}
          quote={camping.editorial_quote}
          pitchup_rating={camping.pitchup_rating}
        />
      </div>

      <!-- Closed Notice if applicable -->
      {camping.status === 'closed_temp' && (
        <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded-r-xl text-amber-900 text-sm">
          <span class="font-bold block text-base mb-1">⚠️ Cerrado Temporalmente</span>
          Este alojamiento se encuentra cerrado temporalmente. Explora otros campings recomendados en {municipalityName}.
        </div>
      )}

      <!-- 1. Component <HeroGallery /> -->
      <HeroGallery image_urls={camping.image_urls} name={camping.name} municipality={municipalityName} />

      <!-- 2. Component <CampingBadges /> -->
      <div>
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Servicios e Instalaciones</h2>
        <CampingBadges amenities={camping.amenities} provinceSlug={provinceSlug} />
      </div>

      <!-- Primary Booking CTA Box -->
      <div class="p-4 bg-emerald-50 rounded-2xl border border-emerald-200/90 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold text-emerald-800 uppercase tracking-wide block">Garantía de Mejor Precio</span>
          <span class="text-xs sm:text-sm text-emerald-950 font-medium">Comprueba disponibilidad y fechas directamente con el alojamiento.</span>
        </div>
        {camping.affiliate_url ? (
          <a
            href={camping.affiliate_url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-md text-center transition shrink-0"
          >
            Reservar Camping &rarr;
          </a>
        ) : camping.official_url ? (
          <a
            href={camping.official_url}
            target="_blank"
            rel="nofollow sponsored"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-extrabold text-sm shadow-md text-center transition shrink-0"
          >
            Reservar en Web Oficial &rarr;
          </a>
        ) : (
          <button
            disabled
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-300 text-slate-600 font-extrabold text-sm text-center cursor-not-allowed opacity-75 shrink-0"
          >
            Reserva no disponible
          </button>
        )}
      </div>

      <!-- 3. Component <CampingHighlights /> -->
      <CampingHighlights
        municipality={municipalityName}
        price_tier={camping.price_tier}
        address={camping.address}
        lat={camping.lat}
        lng={camping.lng}
        seasonality={camping.seasonality}
      />

      <!-- Real-time Weather & Seasonal Climate Module -->
      <div data-testid="weather-widget" class="bg-gradient-to-r from-blue-50 to-slate-50 border border-blue-200/80 rounded-2xl p-4 my-4 space-y-4">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-blue-900 uppercase tracking-wider">☀️ Previsión del Tiempo a 3 Días ({municipalityName})</span>
            <span class="text-[10px] text-blue-600 font-medium">Vía Open-Meteo API</span>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center">
            {weatherForecast.map((w) => (
              <div class="bg-white/80 border border-blue-100 rounded-xl p-2.5 shadow-2xs">
                <span class="text-[11px] font-bold text-slate-700 block capitalize">{w.date}</span>
                <span class="text-xl my-1 block">{weatherIcons[w.weatherCode] || '☀️'}</span>
                <span class="text-xs font-bold text-slate-900">{w.tempMax}°C</span>
                <span class="text-[10px] text-slate-400 block">{w.tempMin}°C min</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Seasonal Climate Module (Monthly average temperatures in Málaga) -->
        <div class="pt-3 border-t border-blue-200/60">
          <span class="text-xs font-bold text-blue-950 uppercase tracking-wider block mb-2">
            🌡️ Clima de Temporada y Temperatura Media Mensual (Málaga / Costa del Sol)
          </span>
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-1.5 text-center text-[11px]">
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Ene</span> 17°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Feb</span> 18°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Mar</span> 20°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Abr</span> 21°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">May</span> 24°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Jun</span> 28°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Jul</span> 31°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Ago</span> 31°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Sep</span> 28°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Oct</span> 24°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Nov</span> 20°C</div>
            <div class="p-1.5 bg-white/70 rounded-lg border border-blue-100"><span class="font-bold block text-slate-600">Dic</span> 18°C</div>
          </div>
          <p class="text-[10px] text-slate-500 mt-2">
            Málaga ofrece más de 320 días de sol al año con inviernos suaves, perfecta para rutas camper en temporada baja.
          </p>
        </div>
      </div>

      <!-- 4. Component <AiDescription /> -->
      <AiDescription
        ai_description={camping.ai_description}
        description={camping.description}
        name={camping.name}
        affiliate_url={camping.affiliate_url}
      />

      <!-- In-Content Ad #1 -->
      <div data-testid="ad-block-incontent" class="my-6 w-full h-[100px] bg-slate-100 border border-slate-200 rounded-xl flex flex-col items-center justify-center text-slate-400 text-xs text-center p-2 shadow-inner">
        <span class="font-bold text-slate-500 uppercase tracking-widest text-[10px]">Publicidad / Google AdSense (In-Content Banner)</span>
        <span class="text-slate-400 text-[11px] mt-0.5">Espacio reservado 728x90 (CLS 0)</span>
      </div>

      <!-- FAQs Section -->
      {camping.faqs_json && camping.faqs_json.length > 0 && (
        <div class="pt-6 border-t border-slate-200">
          <h2 class="text-xl font-bold text-slate-900 mb-4">Preguntas Frecuentes sobre {camping.name}</h2>
          <div class="space-y-4">
            {camping.faqs_json.map((faq: { question: string; answer: string }) => (
              <details class="bg-slate-50 border border-slate-200 rounded-xl p-4 group">
                <summary class="font-semibold text-slate-900 cursor-pointer flex justify-between items-center text-sm">
                  <span>{faq.question}</span>
                  <span class="text-emerald-600 transition group-open:rotate-180">&darr;</span>
                </summary>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-2">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Environment Block: Qué hacer en [Municipio] + Módulo de Experiencias y Excursiones -->
      <div data-testid="environment-block" class="pt-6 border-t border-slate-200 space-y-6">
        <div class="bg-emerald-50/70 border border-emerald-200/80 rounded-2xl p-5">
          <h3 class="text-sm font-extrabold text-emerald-950 uppercase tracking-wide mb-2">
            Qué hacer en {municipalityName} y Alrededores
          </h3>
          <p class="text-xs text-emerald-900 mb-3 leading-relaxed">
            Descubre otros alojamientos y categorías destacadas dentro de {municipalityName} para planificar tu ruta de naturaleza.
          </p>
          <div class="flex flex-wrap gap-2 text-xs">
            <a href={`${import.meta.env.BASE_URL}${provinceSlug}/`} class="px-3 py-1.5 bg-white border border-emerald-300 rounded-lg text-emerald-800 font-semibold hover:bg-emerald-100 transition shadow-2xs">
              &larr; Todos los campings en Provincia de {provinceName}
            </a>
            <a href={`${import.meta.env.BASE_URL}${provinceSlug}/campings-con-mascotas/`} class="px-3 py-1.5 bg-white border border-emerald-300 rounded-lg text-emerald-800 font-semibold hover:bg-emerald-100 transition shadow-2xs">
              Campings que admiten mascotas en {provinceName}
            </a>
            <a href={`${import.meta.env.BASE_URL}${provinceSlug}/campings-con-piscina/`} class="px-3 py-1.5 bg-white border border-emerald-300 rounded-lg text-emerald-800 font-semibold hover:bg-emerald-100 transition shadow-2xs">
              Campings con piscina en {provinceName}
            </a>
          </div>
        </div>

        <!-- Módulo 1: Qué hacer en los alrededores (Tarjetas Klook/Tiqets) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-rose-600 uppercase tracking-wider block">Actividades & Experiencias</span>
              <h3 class="text-lg font-extrabold text-slate-900">Excursiones más cercanas a {camping.name}</h3>
            </div>
            <a href="https://klook.tpx.lv/yBJjXg2w" target="_blank" rel="nofollow sponsored" class="text-xs font-bold text-rose-600 hover:underline">
              Ver todas en Klook &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {municipalityName.toLowerCase().includes('ronda') ? (
              <>
                <AffiliateCard
                  type="activity"
                  title="Visita a Bodega Tradicional y Cata de Vinos en Ronda"
                  badge="Enología Ronda"
                  location="Ronda"
                  price="Desde €25"
                  imageUrl="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=800&q=80"
                  url="https://klook.tpx.lv/yBJjXg2w"
                />
                <AffiliateCard
                  type="activity"
                  title="Entrada con Audioguía Monumentos y Puente Nuevo de Ronda"
                  badge="Imprescindible"
                  location="Ronda"
                  price="Desde €12"
                  imageUrl="https://images.unsplash.com/photo-1563299796-b729d0af54a5?auto=format&fit=crop&w=800&q=80"
                  url="https://klook.tpx.lv/yBJjXg2w"
                />
              </>
            ) : (
              <>
                <AffiliateCard
                  type="activity"
                  title="Paseo en Catamarán y Avistamiento de Delfines en la Costa del Sol"
                  badge="Popular Costa"
                  location="Costa del Sol / Málaga"
                  price="Desde €18"
                  imageUrl="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=80"
                  url="https://klook.tpx.lv/yBJjXg2w"
                />
                <AffiliateCard
                  type="activity"
                  title="Ruta Guiada Caminito del Rey con Entrada Oficial Incluida"
                  badge="Aventura Málaga"
                  location="El Chorro / Málaga"
                  price="Desde €29"
                  imageUrl="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=80"
                  url="https://klook.tpx.lv/yBJjXg2w"
                />
              </>
            )}
          </div>
        </div>

        <!-- Módulo Check-out / Salida (Radical Storage) -->
        <AffiliateBanner
          type="luggage"
          url="https://radicalstorage.tpx.lv/0xPPfViP"
          title="¿Tu vuelo o tren sale tarde tras el Check-out?"
          description={`Guarda tu equipaje de forma segura en las consignas de Málaga antes de dirigirte al aeropuerto o estación.`}
          buttonText="Consigna Radical Storage"
          locationName="Málaga Capital"
        />

        <!-- Bloque de Interconexión Jerárquica de Enlazado Interno -->
        <div class="space-y-6 pt-4 border-t border-slate-200">
          <!-- 1. Mismo Municipio -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-base font-extrabold text-slate-900">Campings en {municipalityName}</h3>
              <a href={`${import.meta.env.BASE_URL}${provinceSlug}/${municipalitySlug}/`} class="text-xs font-bold text-emerald-600 hover:underline">
                Ver hub de {municipalityName} &rarr;
              </a>
            </div>
            {sameMunicipalityCampings.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {sameMunicipalityCampings.map((rec) => (
                  <CampingCard camping={rec} />
                ))}
              </div>
            ) : (
              <p class="text-xs text-slate-500 italic bg-slate-50 p-3 rounded-xl border border-slate-200">
                Este es el único camping registrado en {municipalityName}. Descubre otros alojamientos en la provincia de {provinceName}.
              </p>
            )}
          </div>

          <!-- 2. Misma Provincia / Misma Categoría -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-base font-extrabold text-slate-900">Otros campings {featuredAmenityName} en la provincia de {provinceName}</h3>
              <a href={`${import.meta.env.BASE_URL}${provinceSlug}/`} class="text-xs font-bold text-emerald-600 hover:underline">
                Ver todos de {provinceName} &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {(sameProvinceCategoryCampings.length > 0 ? sameProvinceCategoryCampings : sameProvinceCampings.slice(0, 2)).map((rec) => (
                <CampingCard camping={rec} />
              ))}
            </div>
          </div>

          <!-- 3. Provincia Vecina -->
          <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 rounded-2xl p-5">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">Explora la región</span>
                <h3 class="text-sm font-extrabold text-slate-900">Ver también campings cerca en {neighborName}</h3>
              </div>
              <a href={`${import.meta.env.BASE_URL}${neighborSlug}/`} class="text-xs font-bold text-emerald-700 bg-white border border-emerald-300 px-3 py-1.5 rounded-xl hover:bg-emerald-100 transition shadow-2xs">
                Ver {neighborName} &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {neighborCampings.map((nc) => (
                <a href={`${import.meta.env.BASE_URL}camping/${nc.slug}/`} class="p-3 bg-white border border-emerald-200 rounded-xl hover:border-emerald-500 transition block group shadow-2xs">
                  <span class="font-bold text-xs text-slate-900 block group-hover:text-emerald-600 transition truncate">{nc.name}</span>
                  <span class="text-[10px] text-slate-500 block truncate">{nc.address}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Sidebar Desktop Column -->
    <div class="hidden lg:block">
      <div class="sticky top-24 space-y-6">

        <!-- Sticky Sidebar Reservation Box -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-md space-y-4">
          <h3 class="font-bold text-lg text-slate-900">Reserva tu estancia</h3>
          <p class="text-xs text-slate-500">Consulta precios y disponibilidad en tiempo real para {camping.name}.</p>

          {camping.affiliate_url ? (
            <a
              href={camping.affiliate_url}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full text-center py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm shadow-md transition"
            >
              Reservar Camping
            </a>
          ) : camping.official_url ? (
            <a
              href={camping.official_url}
              target="_blank"
              rel="nofollow sponsored"
              class="block w-full text-center py-3.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-extrabold text-sm shadow-md transition"
            >
              Reservar en Web Oficial
            </a>
          ) : (
            <button
              disabled
              class="block w-full text-center py-3.5 px-4 rounded-xl bg-slate-200 text-slate-500 font-extrabold text-sm cursor-not-allowed opacity-75"
            >
              Reserva no disponible
            </button>
          )}
        </div>

        <!-- Desktop Sidebar Banner -->
        <div data-testid="ad-block-sidebar" class="w-full h-[300px] bg-slate-100 border border-slate-200 rounded-2xl flex flex-col items-center justify-center text-slate-400 text-xs text-center p-4 shadow-inner">
          <span class="font-bold text-slate-500 uppercase tracking-widest text-[10px]">Publicidad / Google AdSense (Sidebar Banner)</span>
          <span class="text-slate-400 text-[11px] mt-1">300x250 Banner Fijo (CLS 0)</span>
        </div>

      </div>
    </div>
  </div>

  <!-- 5. Component <StickyCtaMobile /> -->
  <StickyCtaMobile
    name={camping.name}
    price_tier={camping.price_tier}
    affiliate_url={camping.affiliate_url}
    official_url={camping.official_url}
  />

  <script is:inline data-slug={camping.slug}>
    (function () {
      const slug = document.currentScript?.getAttribute('data-slug');
      if (!slug) return;

      function cleanUrl(url) {
        if (!url) return '';
        let c = url.trim();
        c = c.replace(/\/+$/, '');
        c = c.replace(/\/rest\/v1\/?$/i, '');
        c = c.replace(/\/+$/, '');
        return c;
      }

      function getSupabaseCredentials() {
        try {
          const stored = localStorage.getItem('mejorescampings_supabase_config');
          if (stored) {
            const parsed = JSON.parse(stored);
            if (parsed.url && parsed.key) {
              return { url: cleanUrl(parsed.url), key: parsed.key.trim() };
            }
          }
        } catch (e) {}

        const el = document.getElementById('campsite-detail-supabase-config');
        if (el) {
          const envUrl = el.getAttribute('data-supabase-url');
          const envKey = el.getAttribute('data-supabase-key');
          if (envUrl && envKey) {
            return { url: cleanUrl(envUrl), key: envKey.trim() };
          }
        }
        return null;
      }

      async function fetchLiveCampsiteData() {
        const creds = getSupabaseCredentials();
        if (!creds?.url || !creds?.key) return null;

        try {
          const res = await fetch(`${creds.url}/rest/v1/campings?slug=eq.${encodeURIComponent(slug)}&select=image_url,image_urls`, {
            headers: {
              'apikey': creds.key,
              'Authorization': `Bearer ${creds.key}`
            }
          });
          if (!res.ok) return null;
          const data = await res.json();
          if (Array.isArray(data) && data.length > 0) {
            return data[0];
          }
          return null;
        } catch (e) {
          console.warn('Live Supabase campsite detail fetch failed:', e);
          return null;
        }
      }

      async function syncCampsiteImages() {
        let ov = null;
        try {
          const raw = localStorage.getItem('mejorescampings_admin_overrides');
          if (raw) {
            const overrides = JSON.parse(raw);
            if (overrides[slug]) ov = overrides[slug];
          }
        } catch (e) {}

        const liveRecord = await fetchLiveCampsiteData();

        // Prioritize live DB record over single-browser localStorage override
        let primaryUrl = liveRecord?.image_url || ov?.image_url;
        let galleryUrls = liveRecord?.image_urls || ov?.image_urls;

        if (Array.isArray(galleryUrls) && galleryUrls.length > 0) {
          if (primaryUrl && galleryUrls.includes(primaryUrl)) {
            galleryUrls = [primaryUrl, ...galleryUrls.filter(u => u !== primaryUrl)];
          }
        } else if (primaryUrl) {
          galleryUrls = [primaryUrl];
        }

        if (!galleryUrls || galleryUrls.length === 0) return;

        const galleryContainer = document.querySelector('[data-hero-gallery]');
        const galleryTrack = document.querySelector('[data-hero-gallery-track]');
        if (galleryTrack && galleryContainer) {
          galleryTrack.innerHTML = '';
          galleryUrls.forEach((img, idx) => {
            const slide = document.createElement('div');
            slide.className = 'snap-start shrink-0 w-full h-full relative';
            slide.setAttribute('data-gallery-slide', '');
            slide.innerHTML = `
              <img
                src="${img}"
                alt="Instalaciones"
                width="1200"
                height="675"
                class="w-full h-full object-cover"
                loading="${idx === 0 ? 'eager' : 'lazy'}"
              />
              <div class="absolute bottom-3 right-3 bg-slate-900/80 text-white text-xs px-3 py-1 rounded-full backdrop-blur-md font-semibold z-10" data-gallery-counter>
                ${idx + 1} / ${galleryUrls.length}
              </div>
            `;
            galleryTrack.appendChild(slide);
          });

          // Ensure navigation buttons exist if multiple images present
          let prevBtn = galleryContainer.querySelector('[data-gallery-prev]');
          let nextBtn = galleryContainer.querySelector('[data-gallery-next]');

          if (galleryUrls.length > 1) {
            if (!prevBtn) {
              prevBtn = document.createElement('button');
              prevBtn.type = 'button';
              prevBtn.setAttribute('data-gallery-prev', '');
              prevBtn.setAttribute('aria-label', 'Imagen anterior');
              prevBtn.className = 'absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center transition shadow-lg opacity-80 hover:opacity-100 z-20 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500';
              prevBtn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>`;
              prevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                galleryTrack.scrollBy({ left: -galleryTrack.clientWidth, behavior: 'smooth' });
              });
              galleryContainer.appendChild(prevBtn);
            }
            if (!nextBtn) {
              nextBtn = document.createElement('button');
              nextBtn.type = 'button';
              nextBtn.setAttribute('data-gallery-next', '');
              nextBtn.setAttribute('aria-label', 'Imagen siguiente');
              nextBtn.className = 'absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center transition shadow-lg opacity-80 hover:opacity-100 z-20 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500';
              nextBtn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>`;
              nextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                galleryTrack.scrollBy({ left: galleryTrack.clientWidth, behavior: 'smooth' });
              });
              galleryContainer.appendChild(nextBtn);
            }
          } else {
            if (prevBtn) prevBtn.remove();
            if (nextBtn) nextBtn.remove();
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncCampsiteImages);
      } else {
        syncCampsiteImages();
      }
    })();
  </script>
</Layout>
