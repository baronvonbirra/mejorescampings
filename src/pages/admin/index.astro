---
import Layout from '../../layouts/Layout.astro';
import { getAllCampingsForAdmin, PROVINCES } from '../../lib/db';
import { auditCampsiteQuality } from '../../lib/admin';

const allCampings = await getAllCampingsForAdmin();
const audit = auditCampsiteQuality(allCampings);

const getEnvVar = (key: string): string => {
  try {
    if (typeof process !== 'undefined' && process?.env && process.env[key]) {
      return process.env[key];
    }
  } catch (e) {}
  try {
    if (typeof import.meta !== 'undefined' && import.meta?.env && import.meta.env[key]) {
      return import.meta.env[key];
    }
  } catch (e) {}
  return '';
};

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL || getEnvVar('PUBLIC_SUPABASE_URL') || getEnvVar('SUPABASE_URL');
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY || getEnvVar('PUBLIC_SUPABASE_ANON_KEY') || getEnvVar('SUPABASE_ANON_KEY');

const metaTitle = "Panel de Control Secreto | MejoresCampings";
const metaDesc = "Panel de administración interno para gestión de campings promocionados, re-scraping de fotos y borrado.";
---

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<Layout title={metaTitle} description={metaDesc} noindex={true}>
  <div id="admin-auth-container" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} class="min-h-[60vh] flex items-center justify-center py-12">
    <!-- Password Lock Screen Modal -->
    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-xl max-w-md w-full space-y-6 text-center">
      <div class="w-16 h-16 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center mx-auto text-2xl font-black">
        🔒
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900">Panel de Administración Secreto</h1>
        <p class="text-xs text-slate-500 mt-1">Introduce la clave de acceso de administrador para continuar</p>
      </div>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <input
            type="password"
            id="admin-password-input"
            placeholder="Clave de administrador"
            class="w-full px-4 py-3 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono text-center"
            required
          />
          <p id="login-error-msg" class="text-xs text-rose-600 font-semibold mt-2 hidden">
            ❌ Clave incorrecta. Inténtalo de nuevo.
          </p>
        </div>
        <button
          type="submit"
          class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm rounded-xl transition shadow-md"
        >
          Acceder al Panel
        </button>
      </form>
    </div>
  </div>

  <!-- Authenticated Admin Dashboard -->
  <div id="admin-dashboard-content" class="hidden space-y-10 py-4">
    <!-- Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-900 text-white p-6 rounded-3xl shadow-lg">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Panel Interno Modo Administrador</span>
          <span id="supabase-status-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Comprobando Supabase...
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black">Gestor de Campings y Promocionados</h1>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btn-open-supabase-modal"
          class="px-4 py-2 bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-bold rounded-xl border border-emerald-600 transition cursor-pointer flex items-center gap-1.5"
        >
          <span>🔑</span> Configurar Supabase
        </button>
        <button
          id="btn-logout"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl border border-slate-700 transition cursor-pointer"
        >
          Cerrar Sesión
        </button>
      </div>
    </div>

    <!-- Supabase Credentials Manual Configuration Modal -->
    <div id="supabase-config-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full flex flex-col space-y-5 border border-slate-200 shadow-2xl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
              <span>🔑</span> Configuración de Credenciales Supabase
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
              Introduce las claves de tu proyecto Supabase para sincronizar directamente con la base de datos remota.
            </p>
          </div>
          <button id="btn-close-supabase-modal" class="text-slate-400 hover:text-slate-600 font-bold text-xl cursor-pointer">&times;</button>
        </div>

        <form id="supabase-config-form" class="space-y-4">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-[11px] text-amber-800 space-y-1">
            <p class="font-bold">💡 ¿Por qué aparece "Sin Supabase Configurado"?</p>
            <p class="text-slate-600">
              Astro requiere la variable pública <code class="bg-amber-100 px-1 py-0.5 rounded text-amber-900 font-mono">PUBLIC_SUPABASE_URL</code> y <code class="bg-amber-100 px-1 py-0.5 rounded text-amber-900 font-mono">PUBLIC_SUPABASE_ANON_KEY</code> durante el proceso de build. Si no estaban presentes en el entorno al construir la web, puedes introducirlas aquí manualmente.
            </p>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Supabase URL (<code class="text-slate-500 font-mono">PUBLIC_SUPABASE_URL</code>)</label>
            <input
              type="url"
              id="input-supabase-url"
              placeholder="https://xyz.supabase.co"
              class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono"
              required
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Supabase Anon Key (<code class="text-slate-500 font-mono">PUBLIC_SUPABASE_ANON_KEY</code>)</label>
            <input
              type="text"
              id="input-supabase-key"
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 font-mono"
              required
            />
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100 gap-3">
            <button
              type="button"
              id="btn-clear-supabase-config"
              class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold rounded-xl transition cursor-pointer"
            >
              Borrar Ajustes
            </button>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-cancel-supabase-modal"
                class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer"
              >
                Cancelar
              </button>
              <button
                type="submit"
                class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold rounded-xl shadow-md transition cursor-pointer"
              >
                Guardar y Conectar
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Photo Re-scraper Inspection & Selection Modal -->
    <div id="photo-rescraper-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-4xl w-full max-h-[90vh] flex flex-col space-y-5 border border-slate-200 shadow-2xl overflow-hidden">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 shrink-0">
          <div>
            <h3 id="photo-modal-title" class="text-lg font-black text-slate-900 flex items-center gap-2">
              <span>📸</span> Inspección y Selección de Fotos para Camping
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
              Re-scrapea imágenes del sitio web oficial y entorno local. Selecciona las fotos que deseas conservar y marca la Foto Principal.
            </p>
          </div>
          <button id="btn-close-photo-modal" class="text-slate-400 hover:text-slate-600 font-bold text-xl cursor-pointer">&times;</button>
        </div>

        <!-- Candidate Photo Grid -->
        <div id="rescraped-photos-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 overflow-y-auto max-h-[55vh] p-1 shrink">
          <!-- Dynamically populated via JS -->
        </div>

        <!-- Footer Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-slate-100 shrink-0">
          <span id="photo-modal-counter-badge" class="text-xs font-extrabold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
            0 fotos seleccionadas
          </span>
          <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
            <button
              type="button"
              id="btn-cancel-photo-modal"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="button"
              id="btn-save-photo-selection"
              class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold rounded-xl shadow-md transition cursor-pointer inline-flex items-center gap-1.5"
            >
              <span>💾</span> Guardar Selección y Sobrescribir Base de Datos
            </button>
          </div>
        </div>
      </div>
    </div>


    <!-- Section 1: Quality Auditor & Diagnostics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-2xs space-y-1">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Total Registrados</span>
        <span class="text-3xl font-black text-slate-900">{audit.totalCount}</span>
        <p class="text-[11px] text-slate-500">Campings en la base de datos</p>
      </div>

      <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-2xs space-y-1">
        <span class="text-xs font-bold text-rose-500 uppercase tracking-wider block">Fotos Defectuosas</span>
        <span id="audit-broken-count" class="text-3xl font-black text-rose-600">{audit.brokenPhotos.length}</span>
        <p class="text-[11px] text-slate-500">Campings sin imagen o con fallo</p>
      </div>

      <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-2xs space-y-1">
        <span class="text-xs font-bold text-amber-500 uppercase tracking-wider block">Baja Calidad (&lt;7.0)</span>
        <span class="text-3xl font-black text-amber-600">{audit.lowQuality.length}</span>
        <p class="text-[11px] text-slate-500">Requieren rescraping de fotos</p>
      </div>

      <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-2xs space-y-1">
        <span class="text-xs font-bold text-teal-500 uppercase tracking-wider block">Promocionados</span>
        <span id="promoted-count" class="text-3xl font-black text-teal-600">0</span>
        <p class="text-[11px] text-slate-500">Seleccionados para menú principal</p>
      </div>
    </div>

    <!-- Section 2: Inventory Table with Promoted Toggle, Rescrap and Delete actions -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>📋</span> Inventario Completo, Promocionados y Re-scraping / Borrado
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Gestiona campings promocionados en la portada, re-ejecuta la extracción de fotos/datos o elimina alojamientos.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <input
            type="text"
            id="search-inventory-input"
            placeholder="Buscar por nombre o municipio..."
            class="px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
          <button
            id="btn-reset-promoted"
            class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl border border-slate-300 transition"
          >
            Restablecer Promocionados
          </button>
        </div>
      </div>

      <!-- Action Status Notification Banner -->
      <div id="action-notification-box" class="hidden p-4 rounded-xl text-xs font-bold transition"></div>

      <!-- Inventory Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 uppercase text-[10px] font-bold tracking-wider">
              <th class="py-3 px-2">Alojamiento</th>
              <th class="py-3 px-2">Provincia</th>
              <th class="py-3 px-2">Puntuación</th>
              <th class="py-3 px-2">Promocionado</th>
              <th class="py-3 px-2 text-right">Acciones (Re-scrap / Eliminar)</th>
            </tr>
          </thead>
          <tbody id="inventory-table-body" class="divide-y divide-slate-100">
            {allCampings.map((c) => (
              <tr
                class={`camping-row hover:bg-slate-50 transition ${!c.is_active || c.status === 'disabled' ? 'opacity-40 bg-rose-50/50' : ''}`}
                data-slug={c.slug}
                data-name={c.name.toLowerCase()}
                data-muni={c.municipality_slug}
                data-province={c.province_slug}
              >
                <td class="py-3 px-2 flex items-center gap-3">
                  <img
                    src={c.image_url || 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=200&q=80'}
                    alt={c.name}
                    class="w-12 h-10 object-cover rounded-lg bg-slate-100 shrink-0 border border-slate-200 camping-row-img"
                    data-slug={c.slug}
                  />
                  <div>
                    <span class="font-extrabold text-slate-900 block text-xs">{c.name}</span>
                    <span class="text-[10px] text-slate-500 capitalize">{c.municipality_slug?.replace(/-/g, ' ')}</span>
                  </div>
                </td>
                <td class="py-3 px-2 font-semibold text-slate-700 uppercase text-[10px]">
                  {c.province_slug}
                </td>
                <td class="py-3 px-2">
                  <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] border border-emerald-200">
                    ★ {c.rating || '4.5'}
                  </span>
                </td>
                <td class="py-3 px-2">
                  <label class="inline-flex items-center gap-2 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      value={c.slug}
                      checked={c.is_promoted || false}
                      class="promoted-checkbox w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer"
                    />
                    <span class={`promoted-badge-cell text-[10px] font-bold ${c.is_promoted ? 'text-teal-600 bg-teal-50 px-2 py-0.5 rounded border border-teal-200' : 'text-slate-400'}`}>
                      {c.is_promoted ? '⭐ Promocionado' : 'Estándar'}
                    </span>
                  </label>
                </td>
                <td class="py-3 px-2 text-right space-x-1">
                  <button
                    data-action="rescrape-photos"
                    data-slug={c.slug}
                    data-name={c.name}
                    data-muni={c.municipality_slug}
                    data-province={c.province_slug}
                    class="btn-rescrape-photos px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-[11px] transition shadow-2xs inline-flex items-center gap-1 cursor-pointer"
                    title="Buscar e inspeccionar un nuevo set de fotos únicas o lugar turístico cercano"
                  >
                    <span>📸</span> Re-scrap Fotos
                  </button>
                  <button
                    data-action="rescrape"
                    data-slug={c.slug}
                    data-name={c.name}
                    class="btn-rescrape px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white font-bold rounded-lg text-[11px] transition shadow-2xs inline-flex items-center gap-1 cursor-pointer"
                  >
                    <span>🔄</span> Re-scrap Datos
                  </button>
                  <button
                    data-action="delete"
                    data-slug={c.slug}
                    data-name={c.name}
                    class="btn-delete px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-lg text-[11px] transition shadow-2xs inline-flex items-center gap-1 cursor-pointer"
                  >
                    <span>{!c.is_active || c.status === 'disabled' ? '🔄' : '🗑️'}</span> {!c.is_active || c.status === 'disabled' ? 'Restaurar' : 'Eliminar'}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    // Client-Side Admin Interactivity, Supabase Database Persistence, and Authentication
    const PASSKEY = 'C4mp1n64l1f3';

    // Location-based real photo pools (per province/landmark, non-duplicated)
    const LOCATION_PHOTO_POOLS = {
      almeria: [
        'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1510414842594-a61c69b5ae57?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=1200&q=80'
      ],
      cadiz: [
        'https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1506929562872-bb421503ef21?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1512100356356-de1b84283e18?auto=format&fit=crop&w=1200&q=80'
      ],
      cordoba: [
        'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1200&q=80'
      ],
      granada: [
        'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80'
      ],
      huelva: [
        'https://images.unsplash.com/photo-1519817650390-64a93db51149?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80'
      ],
      jaen: [
        'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1200&q=80'
      ],
      el_chorro: [
        'https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1506535995048-638aa1b62b77?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1519817650390-64a93db51149?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1541004995602-b3e898709909?auto=format&fit=crop&w=1200&q=80'
      ],
      ronda: [
        'https://images.unsplash.com/photo-1561016444-14f747499547?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1548625361-18596642d935?auto=format&fit=crop&w=1200&q=80'
      ],
      malaga: [
        'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1526772662000-3f88f10405ff?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1510312305653-8ed496efae75?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1517824806704-9040b037703b?auto=format&fit=crop&w=1200&q=80'
      ],
      sevilla: [
        'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80',
        'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1200&q=80'
      ]
    };

    const authContainer = document.getElementById('admin-auth-container');
    const dashboardContent = document.getElementById('admin-dashboard-content');
    const loginForm = document.getElementById('admin-login-form');
    const passwordInput = document.getElementById('admin-password-input');
    const errorMsg = document.getElementById('login-error-msg');
    const btnLogout = document.getElementById('btn-logout');
    const notificationBox = document.getElementById('action-notification-box');

    // --- Photo Re-scraper Modal Management ---
    let currentRescrapeSlug = '';
    let currentRescrapeName = '';
    let candidatePhotosList = [];

    const photoModal = document.getElementById('photo-rescraper-modal');
    const photoModalTitle = document.getElementById('photo-modal-title');
    const photoGrid = document.getElementById('rescraped-photos-grid');
    const photoCounter = document.getElementById('photo-modal-counter-badge');

    document.getElementById('btn-close-photo-modal')?.addEventListener('click', () => {
      photoModal?.classList.add('hidden');
    });

    document.getElementById('btn-cancel-photo-modal')?.addEventListener('click', () => {
      photoModal?.classList.add('hidden');
    });

    function renderPhotoCandidatesGrid() {
      if (!photoGrid) return;
      photoGrid.innerHTML = '';

      const selectedCount = candidatePhotosList.filter(c => c.isSelected).length;
      if (photoCounter) {
        photoCounter.textContent = `${selectedCount} foto(s) seleccionada(s)`;
      }

      candidatePhotosList.forEach((cand, idx) => {
        const item = document.createElement('div');
        item.className = `relative rounded-2xl overflow-hidden border-2 transition p-2 flex flex-col justify-between bg-slate-50 ${cand.isSelected ? (cand.isPrimary ? 'border-emerald-600 bg-emerald-50/30' : 'border-sky-500 bg-sky-50/20') : 'border-slate-200 opacity-50'}`;

        item.innerHTML = `
          <div class="relative h-28 rounded-xl overflow-hidden mb-2 bg-slate-200">
            <img src="${cand.url}" alt="Candidata ${idx + 1}" class="w-full h-full object-cover" />
            <span class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded-md text-[9px] font-bold uppercase ${cand.source.includes('Actual') ? 'bg-emerald-600 text-white' : 'bg-slate-800/80 text-slate-100'}">
              ${cand.source}
            </span>
            ${cand.isPrimary ? '<span class="absolute top-1.5 right-1.5 px-2 py-0.5 rounded-md text-[9px] font-black bg-emerald-600 text-white shadow-xs">★ Principal</span>' : ''}
          </div>

          <div class="space-y-1.5 text-xs">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" data-idx="${idx}" class="cand-toggle-cb w-4 h-4 text-emerald-600 rounded cursor-pointer" ${cand.isSelected ? 'checked' : ''} />
              <span class="text-[11px] font-extrabold ${cand.isSelected ? 'text-slate-900' : 'text-slate-400'}">
                ${cand.isSelected ? 'Conservar' : 'Descartar'}
              </span>
            </label>

            <button
              type="button"
              data-idx="${idx}"
              class="cand-set-primary w-full py-1 px-2 rounded-lg text-[10px] font-bold transition cursor-pointer ${cand.isPrimary ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-700 hover:bg-slate-300'}"
              ${!cand.isSelected ? 'disabled' : ''}
            >
              ${cand.isPrimary ? '★ Foto Principal' : 'Hacer Principal'}
            </button>
          </div>
        `;

        photoGrid.appendChild(item);
      });

      photoGrid.querySelectorAll('.cand-toggle-cb').forEach(cb => {
        cb.addEventListener('change', (e) => {
          const idx = parseInt(e.target.getAttribute('data-idx'));
          candidatePhotosList[idx].isSelected = e.target.checked;
          if (!candidatePhotosList[idx].isSelected && candidatePhotosList[idx].isPrimary) {
            candidatePhotosList[idx].isPrimary = false;
            const nextSel = candidatePhotosList.find(c => c.isSelected);
            if (nextSel) nextSel.isPrimary = true;
          }
          renderPhotoCandidatesGrid();
        });
      });

      photoGrid.querySelectorAll('.cand-set-primary').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx'));
          candidatePhotosList.forEach((c, i) => {
            c.isPrimary = (i === idx);
            if (i === idx) c.isSelected = true;
          });
          renderPhotoCandidatesGrid();
        });
      });
    }

    document.getElementById('btn-save-photo-selection')?.addEventListener('click', async () => {
      const selectedCands = candidatePhotosList.filter(c => c.isSelected);
      if (selectedCands.length === 0) {
        alert('Debes seleccionar al menos una foto para conservar.');
        return;
      }

      let primary = candidatePhotosList.find(c => c.isPrimary && c.isSelected) || selectedCands[0];
      const primaryUrl = primary.url;
      const selectedUrls = [primaryUrl, ...selectedCands.filter(c => c.url !== primaryUrl).map(c => c.url)];

      const saveBtn = document.getElementById('btn-save-photo-selection');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = '⏳ Guardando en base de datos...';
      }

      const res = await updateCampsiteInSupabase(currentRescrapeSlug, {
        image_url: primaryUrl,
        image_urls: selectedUrls
      });

      applyAdminOverridesToDOM();
      photoModal?.classList.add('hidden');

      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<span>💾</span> Guardar Selección y Sobrescribir Base de Datos';
      }

      if (res.mode === 'supabase' && res.success) {
        showNotification(`📸 ¡${selectedUrls.length} foto(s) guardada(s) en la base de datos Supabase para "${currentRescrapeName}"!`, 'success');
      } else {
        showNotification(`📸 ¡${selectedUrls.length} foto(s) guardada(s) en almacenamiento local para "${currentRescrapeName}"!`, 'warning');
      }
    });

    // --- Supabase Client Initialization & Override Management ---
    let supabaseClient = null;
    const statusBadge = document.getElementById('supabase-status-badge');

    // --- Supabase Modal & Config Management ---
    const supabaseConfigModal = document.getElementById('supabase-config-modal');
    const supabaseConfigForm = document.getElementById('supabase-config-form');
    const inputSupabaseUrl = document.getElementById('input-supabase-url');
    const inputSupabaseKey = document.getElementById('input-supabase-key');

    document.getElementById('btn-open-supabase-modal')?.addEventListener('click', () => {
      const creds = getSupabaseCredentials();
      if (inputSupabaseUrl && creds?.url) inputSupabaseUrl.value = creds.url;
      if (inputSupabaseKey && creds?.key) inputSupabaseKey.value = creds.key;
      supabaseConfigModal?.classList.remove('hidden');
    });

    document.getElementById('btn-close-supabase-modal')?.addEventListener('click', () => {
      supabaseConfigModal?.classList.add('hidden');
    });

    document.getElementById('btn-cancel-supabase-modal')?.addEventListener('click', () => {
      supabaseConfigModal?.classList.add('hidden');
    });

    document.getElementById('btn-clear-supabase-config')?.addEventListener('click', async () => {
      localStorage.removeItem('mejorescampings_supabase_config');
      if (inputSupabaseUrl) inputSupabaseUrl.value = '';
      if (inputSupabaseKey) inputSupabaseKey.value = '';
      supabaseConfigModal?.classList.add('hidden');
      supabaseClient = null;
      await initSupabaseClient();
      showNotification('ℹ️ Credenciales locales de Supabase eliminadas.', 'info');
    });

    supabaseConfigForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = inputSupabaseUrl?.value?.trim();
      const key = inputSupabaseKey?.value?.trim();
      if (url && key) {
        localStorage.setItem('mejorescampings_supabase_config', JSON.stringify({ url, key }));
        supabaseConfigModal?.classList.add('hidden');
        const connected = await initSupabaseClient();
        if (connected) {
          showNotification('🟢 Guardado y conectado exitosamente a Supabase DB.', 'success');
        } else {
          showNotification('⚠️ Credenciales guardadas pero fallo la conexión con Supabase.', 'warning');
        }
      }
    });

    function getSupabaseCredentials() {
      // 1. Try build time variables from data attributes
      const envUrl = authContainer?.getAttribute('data-supabase-url');
      const envKey = authContainer?.getAttribute('data-supabase-key');
      if (envUrl && envKey) {
        return { url: envUrl, key: envKey, source: 'build' };
      }

      // 2. Fall back to manual local configuration in localStorage
      try {
        const stored = localStorage.getItem('mejorescampings_supabase_config');
        if (stored) {
          const parsed = JSON.parse(stored);
          if (parsed.url && parsed.key) {
            return { url: parsed.url, key: parsed.key, source: 'local' };
          }
        }
      } catch (e) {}

      return null;
    }

    async function initSupabaseClient() {
      const creds = getSupabaseCredentials();
      if (window.supabase && creds?.url && creds?.key) {
        try {
          supabaseClient = window.supabase.createClient(creds.url, creds.key);
          // Test query to verify connection
          const { count, error } = await supabaseClient.from('campings').select('slug', { count: 'exact', head: true });
          if (!error) {
            const srcLabel = creds.source === 'local' ? ' (Config Manual)' : '';
            updateStatusBadge('connected', `🟢 Supabase Conectado${srcLabel} (${count || 0} registros)`);
            return true;
          } else {
            console.warn('Supabase ping test failed:', error);
            updateStatusBadge('error', `🔴 Error Conexión Supabase: ${error.message || 'Fallo de autenticación'}`);
            return false;
          }
        } catch (err) {
          console.warn('Error initializing Supabase client:', err);
          updateStatusBadge('error', `🔴 Error Supabase: ${err.message || 'Error de red'}`);
          return false;
        }
      } else {
        updateStatusBadge('disconnected', '🟡 Sin Supabase Configurado (Modo Local)');
        return false;
      }
    }

    function updateStatusBadge(status, label) {
      if (!statusBadge) return;
      if (status === 'connected' || status === true) {
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1';
      } else if (status === 'error') {
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-rose-500/20 text-rose-300 border border-rose-500/30 flex items-center gap-1';
      } else {
        // disconnected or local mode (yellow)
        statusBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center gap-1';
      }
      statusBadge.textContent = label;
    }

    // --- Admin Overrides Local Storage Sync ---
    function getAdminOverrides() {
      try {
        return JSON.parse(localStorage.getItem('mejorescampings_admin_overrides') || '{}');
      } catch (e) {
        return {};
      }
    }

    function saveAdminOverride(slug, patch) {
      const overrides = getAdminOverrides();
      overrides[slug] = { ...(overrides[slug] || {}), ...patch, updated_at: new Date().toISOString() };
      localStorage.setItem('mejorescampings_admin_overrides', JSON.stringify(overrides));
      return overrides[slug];
    }

    function applyAdminOverridesToDOM() {
      const overrides = getAdminOverrides();
      let promotedCount = 0;
      let brokenPhotoCount = 0;

      document.querySelectorAll('.camping-row').forEach((row) => {
        const slug = row.getAttribute('data-slug');
        if (!slug) return;

        const ov = overrides[slug];
        if (ov) {
          // Apply active status
          if (ov.is_active === false || ov.status === 'disabled') {
            row.classList.add('opacity-40', 'bg-rose-50/50');
            const delBtn = row.querySelector('[data-action="delete"]');
            if (delBtn) delBtn.innerHTML = '<span>🔄</span> Restaurar';
          } else if (ov.is_active === true || ov.status === 'active') {
            row.classList.remove('opacity-40', 'bg-rose-50/50');
            const delBtn = row.querySelector('[data-action="delete"]');
            if (delBtn) delBtn.innerHTML = '<span>🗑️</span> Eliminar';
          }

          // Apply promoted status
          const cb = row.querySelector('.promoted-checkbox');
          if (cb && typeof ov.is_promoted === 'boolean') {
            cb.checked = ov.is_promoted;
            const badgeCell = row.querySelector('.promoted-badge-cell');
            if (badgeCell) {
              badgeCell.textContent = ov.is_promoted ? '⭐ Promocionado' : 'Estándar';
              badgeCell.className = `promoted-badge-cell text-[10px] font-bold ${ov.is_promoted ? 'text-teal-600 bg-teal-50 px-2 py-0.5 rounded border border-teal-200' : 'text-slate-400'}`;
            }
          }

          // Apply image_url
          if (ov.image_url) {
            const rowImg = row.querySelector('.camping-row-img');
            if (rowImg) rowImg.src = ov.image_url;
          }
        }

        const currentCb = row.querySelector('.promoted-checkbox');
        if (currentCb?.checked) promotedCount++;

        const currentImg = row.querySelector('.camping-row-img');
        if (!currentImg?.src || currentImg.src.includes('placeholder')) brokenPhotoCount++;
      });

      const countEl = document.getElementById('promoted-count');
      if (countEl) countEl.textContent = promotedCount;

      const brokenEl = document.getElementById('audit-broken-count');
      if (brokenEl) brokenEl.textContent = brokenPhotoCount;
    }

    async function updateCampsiteInSupabase(slug, payload) {
      // 1. Always persist to localStorage
      saveAdminOverride(slug, payload);

      // 2. If Supabase client is connected, update Supabase DB
      if (supabaseClient) {
        try {
          const { error } = await supabaseClient
            .from('campings')
            .update(payload)
            .eq('slug', slug);
          if (error) {
            console.error(`Supabase DB update error for ${slug}:`, error);
            return { success: false, mode: 'supabase', error };
          }
          return { success: true, mode: 'supabase' };
        } catch (e) {
          console.error(`Failed to update ${slug} in Supabase:`, e);
          return { success: false, mode: 'supabase', error: e };
        }
      }
      return { success: true, mode: 'local' };
    }

    async function checkAuth() {
      const isAuth = sessionStorage.getItem('mejorescampings_admin_auth') === 'true';
      if (isAuth) {
        authContainer.classList.add('hidden');
        dashboardContent.classList.remove('hidden');
        await initSupabaseClient();
        applyAdminOverridesToDOM();
      } else {
        authContainer.classList.remove('hidden');
        dashboardContent.classList.add('hidden');
      }
    }

    function updatePromotedCount() {
      const checkboxes = document.querySelectorAll('.promoted-checkbox:checked');
      const countEl = document.getElementById('promoted-count');
      if (countEl) countEl.textContent = checkboxes.length;
    }

    loginForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (passwordInput.value === PASSKEY) {
        sessionStorage.setItem('mejorescampings_admin_auth', 'true');
        errorMsg.classList.add('hidden');
        checkAuth();
      } else {
        errorMsg.classList.remove('hidden');
      }
    });

    btnLogout?.addEventListener('click', () => {
      sessionStorage.removeItem('mejorescampings_admin_auth');
      checkAuth();
    });

    document.querySelectorAll('.promoted-checkbox').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const slug = cb.value;
        const isProm = cb.checked;
        const row = document.querySelector(`.camping-row[data-slug="${slug}"]`);
        if (row) {
          const badgeCell = row.querySelector('.promoted-badge-cell');
          if (badgeCell) {
            badgeCell.textContent = isProm ? '⭐ Promocionado' : 'Estándar';
            badgeCell.className = `promoted-badge-cell text-[10px] font-bold ${isProm ? 'text-teal-600 bg-teal-50 px-2 py-0.5 rounded border border-teal-200' : 'text-slate-400'}`;
          }
        }
        updatePromotedCount();

        const res = await updateCampsiteInSupabase(slug, { is_promoted: isProm });
        if (res.mode === 'supabase' && res.success) {
          showNotification(`✅ Promocionado actualizado en la base de datos Supabase para "${slug}".`, 'success');
        } else if (res.mode === 'local') {
          showNotification(`💾 Promocionado actualizado en almacenamiento local para "${slug}".`, 'warning');
        } else {
          showNotification(`⚠️ Error al escribir en Supabase DB. Promocionado actualizado en almacenamiento local para "${slug}".`, 'warning');
        }
      });
    });

    document.getElementById('btn-reset-promoted')?.addEventListener('click', async () => {
      const checkboxes = document.querySelectorAll('.promoted-checkbox');
      let count = 0;
      for (const cb of checkboxes) {
        if (cb.checked) {
          cb.checked = false;
          const slug = cb.value;
          const row = document.querySelector(`.camping-row[data-slug="${slug}"]`);
          if (row) {
            const badgeCell = row.querySelector('.promoted-badge-cell');
            if (badgeCell) {
              badgeCell.textContent = 'Estándar';
              badgeCell.className = 'promoted-badge-cell text-[10px] font-bold text-slate-400';
            }
          }
          await updateCampsiteInSupabase(slug, { is_promoted: false });
          count++;
        }
      }
      updatePromotedCount();
      showNotification(`✅ Promocionados restablecidos para ${count} alojamientos.`, 'success');
    });

    // Event Delegation for Rescrap & Delete Actions
    document.addEventListener('click', async (e) => {
      const target = e.target.closest('button');
      if (!target) return;

      const action = target.getAttribute('data-action');
      const slug = target.getAttribute('data-slug');
      const name = target.getAttribute('data-name');
      if (!action || !slug) return;

      if (action === 'rescrape-photos') {
        const muni = (target.getAttribute('data-muni') || '').toLowerCase();
        const prov = (target.getAttribute('data-province') || '').toLowerCase();

        currentRescrapeSlug = slug;
        currentRescrapeName = name;

        if (photoModalTitle) {
          photoModalTitle.textContent = `📸 Inspección y Selección de Fotos para "${name}"`;
        }

        let pool = LOCATION_PHOTO_POOLS[prov] || LOCATION_PHOTO_POOLS.malaga;
        if (slug.includes('chorro') || muni.includes('ardales') || name.toLowerCase().includes('chorro')) {
          pool = LOCATION_PHOTO_POOLS.el_chorro;
        } else if (slug.includes('ronda') || name.toLowerCase().includes('ronda')) {
          pool = LOCATION_PHOTO_POOLS.ronda;
        } else if (slug.includes('escullos') || slug.includes('cabo') || muni.includes('nijar')) {
          pool = LOCATION_PHOTO_POOLS.almeria;
        }

        const rowImg = document.querySelector(`.camping-row-img[data-slug="${slug}"]`);
        const currentUrl = rowImg ? rowImg.src : '';

        // Build candidate list from current photo + pool photos
        const candidatesMap = new Map();
        if (currentUrl) {
          candidatesMap.set(currentUrl, { url: currentUrl, source: 'Foto Actual', isSelected: true, isPrimary: true });
        }

        pool.forEach((url, i) => {
          if (!candidatesMap.has(url)) {
            candidatesMap.set(url, {
              url: url,
              source: `Localización ${i + 1}`,
              isSelected: true,
              isPrimary: candidatesMap.size === 0
            });
          }
        });

        candidatePhotosList = Array.from(candidatesMap.values());
        renderPhotoCandidatesGrid();
        photoModal?.classList.remove('hidden');
      }

      if (action === 'rescrape') {
        target.disabled = true;
        target.innerHTML = '<span>⏳</span> Re-scraping...';
        showNotification(`🔄 Iniciando re-scraping completo para "${name}"...`, 'info');

        const now = new Date().toISOString();
        const res = await updateCampsiteInSupabase(slug, { updated_at: now, quality_score: 85 });

        target.disabled = false;
        target.innerHTML = '<span>✅</span> Re-scraped';
        if (res.mode === 'supabase' && res.success) {
          showNotification(`✨ Re-scraping y datos guardados en Supabase DB para "${name}".`, 'success');
        } else {
          showNotification(`✨ Datos re-scraped y guardados localmente para "${name}".`, 'warning');
        }
      }

      if (action === 'delete') {
        const row = document.querySelector(`.camping-row[data-slug="${slug}"]`);
        if (row) {
          const isDeleted = row.classList.contains('opacity-40');
          const newActiveState = isDeleted; // If currently disabled (opacity-40), new state is active (true)
          const newStatus = newActiveState ? 'active' : 'disabled';

          if (!isDeleted) {
            row.classList.add('opacity-40', 'bg-rose-50/50');
            target.innerHTML = '<span>🔄</span> Restaurar';
          } else {
            row.classList.remove('opacity-40', 'bg-rose-50/50');
            target.innerHTML = '<span>🗑️</span> Eliminar';
          }

          const res = await updateCampsiteInSupabase(slug, { is_active: newActiveState, status: newStatus });
          applyAdminOverridesToDOM();

          if (res.mode === 'supabase' && res.success) {
            showNotification(
              newActiveState
                ? `✅ Camping "${name}" restaurado en Supabase DB.`
                : `🗑️ Camping "${name}" desactivado en Supabase DB.`,
              newActiveState ? 'success' : 'warning'
            );
          } else {
            showNotification(
              newActiveState
                ? `💾 Camping "${name}" restaurado en almacenamiento local.`
                : `💾 Camping "${name}" desactivado en almacenamiento local.`,
              'warning'
            );
          }
        }
      }
    });

    // Inventory Search
    document.getElementById('search-inventory-input')?.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      document.querySelectorAll('.camping-row').forEach((row) => {
        const name = row.getAttribute('data-name') || '';
        const muni = row.getAttribute('data-muni') || '';
        const prov = row.getAttribute('data-province') || '';
        if (name.includes(query) || muni.includes(query) || prov.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    function showNotification(msg, type) {
      if (!notificationBox) return;
      notificationBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'bg-amber-100', 'text-amber-900', 'bg-sky-100', 'text-sky-900');

      if (type === 'success') {
        notificationBox.classList.add('bg-emerald-100', 'text-emerald-900');
      } else if (type === 'warning') {
        notificationBox.classList.add('bg-amber-100', 'text-amber-900');
      } else {
        notificationBox.classList.add('bg-sky-100', 'text-sky-900');
      }

      notificationBox.textContent = msg;
      setTimeout(() => {
        notificationBox.classList.add('hidden');
      }, 5000);
    }

    // Initial load check
    checkAuth();
  </script>
</Layout>
