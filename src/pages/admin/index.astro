      const provName = (currentRescrapeProvince || '').replace(/-/g, ' ');

      const searchQueries = [
        `${currentRescrapeName}`,
        `${muniName} ${provName} turismo`,
        `camping ${provName}`
      ];

      let freshUrls = [];
      for (const q of searchQueries) {
        if (!q.trim()) continue;
        const scraped = await fetchWikimediaImages(q);
        freshUrls = [...freshUrls, ...scraped];
        if (freshUrls.length >= 8) break;
      }

      // Also include expanded regional pools
      const prov = (currentRescrapeProvince || 'malaga').toLowerCase();
