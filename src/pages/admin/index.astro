    async function fetchWikimediaImages(searchTerm) {
      try {
        const url = `https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrsearch=${encodeURIComponent(searchTerm)}&gsrnamespace=6&gsrlimit=8&prop=imageinfo&iiprop=url|size&format=json&origin=*`;
        const res = await fetch(url);
        if (!res.ok) return [];
        const data = await res.json();
        if (!data?.query?.pages) return [];

        const urls = [];
        const allowedExts = ['.jpg', '.jpeg', '.png', '.webp'];
        for (const pid of Object.keys(data.query.pages)) {
          const page = data.query.pages[pid];
          const info = page.imageinfo?.[0];
          if (info && info.url && info.width && info.width >= 350) {
            const lowerUrl = info.url.toLowerCase();
            if (allowedExts.some(ext => lowerUrl.endsWith(ext) || lowerUrl.includes(ext + '?'))) {
              urls.push(info.url);
            }
          }
        }
        return urls;
      } catch (e) {
        console.warn('Wikimedia fetch failed:', e);
        return [];
      }
    }

