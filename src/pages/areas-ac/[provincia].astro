---
import Layout from '../../layouts/Layout.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import CampingCard from '../../components/CampingCard.astro';
import { getCampings, PROVINCES } from '../../lib/db';
import { AREAS_AC } from '../../lib/areasAcData';

export async function getStaticPaths() {
  return PROVINCES.map((p) => ({
    params: { provincia: p.slug },
    props: { provInfo: p }
  }));
}

const { provincia } = Astro.params;
const { provInfo } = Astro.props;

const provName = provInfo ? provInfo.name : provincia.charAt(0).toUpperCase() + provincia.slice(1);

const areas = AREAS_AC.filter((a) => a.provinceSlug.toLowerCase() === provincia.toLowerCase());

const allCampings = await getCampings();
const provCampings = allCampings
  .filter((c) => (c.province_slug || 'malaga').toLowerCase() === provincia.toLowerCase())
  .slice(0, 3);

const pageTitle = `Áreas de Autocaravanas y Campers en ${provName} (Áreas AC) | MejoresCampings`;
const pageDescription = `Directorio de áreas de servicio y pernocta de autocaravanas en ${provName}. Precios, plazas, vaciado de aguas grises/negras, toma eléctrica y coordenadas GPS.`;

const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Áreas de Autocaravanas en ${provName}`,
  "numberOfItems": areas.length,
  "itemListElement": areas.map((a, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": a.name,
    "description": a.description
  }))
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />

  <!-- Breadcrumbs -->
  <nav class="text-xs font-medium text-slate-500 mb-4 flex items-center gap-1.5 flex-wrap">
    <a href={import.meta.env.BASE_URL} class="hover:text-slate-800">Inicio</a>
    <span>/</span>
    <a href={`${import.meta.env.BASE_URL}areas-ac/`} class="hover:text-slate-800">Áreas AC</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">{provName}</span>
  </nav>

  <!-- Hero Header -->
  <header class="bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white rounded-3xl p-8 sm:p-12 mb-8 shadow-xl">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-block px-3 py-1 bg-teal-500/30 backdrop-blur-md rounded-full text-xs font-bold tracking-wider text-teal-300 uppercase">
        Provincia de {provName}
      </span>
      <span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-bold text-slate-200">
        Puntos de Servicio AC 2026
      </span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight">
      Áreas de Autocaravanas y Servicio Camper en {provName}
    </h1>
    <p class="mt-3 text-slate-300 text-xs sm:text-base max-w-2xl leading-relaxed">
      Consulta la ubicación, servicios de vaciado de aguas, toma eléctrica y tarifas de las áreas de servicio y pernocta públicas y privadas en {provName}.
    </p>
  </header>

  <!-- Legal Reminder Banner -->
  <div class="mb-8 p-5 bg-amber-50 border border-amber-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <h2 class="font-extrabold text-amber-950 text-sm sm:text-base flex items-center gap-2">
        ⚠️ Atención a la Normativa de Pernocta en {provName}
      </h2>
      <p class="text-xs text-amber-900">
        Recuerda distinguir entre estacionar/pernoctar (permitido sin sacar elementos) y acampar (prohibido en vía pública).
      </p>
    </div>
    <a
      href={`${import.meta.env.BASE_URL}guias/normativa-pernocta-${provincia}/`}
      class="shrink-0 px-4 py-2 bg-amber-900 hover:bg-amber-950 text-white font-bold text-xs rounded-xl transition"
    >
      Leer Guía Legal {provName} &rarr;
    </a>
  </div>

  <!-- Areas AC Cards List -->
  <div class="space-y-6 mb-12">
    {areas.length > 0 ? (
      areas.map((area) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-2xs hover:shadow-md transition space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div>
              <span class="text-xs font-bold text-teal-700 uppercase tracking-wider block">{area.municipality} ({area.province})</span>
              <h2 class="text-xl font-extrabold text-slate-900">{area.name}</h2>
              <p class="text-xs text-slate-500 mt-0.5">📍 {area.address}</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class={`px-3 py-1 rounded-full text-xs font-extrabold ${area.isFree ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-800'}`}>
                💰 {area.priceInfo}
              </span>
              <span class="px-3 py-1 bg-teal-50 border border-teal-200 text-teal-900 text-xs font-bold rounded-full">
                🚐 {area.capacity} Plazas
              </span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            {area.description}
          </p>

          <!-- Services Grid -->
          <div class="pt-2">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-2">Servicios Disponibles:</span>
            <div class="flex flex-wrap gap-2 text-xs font-semibold">
              <span class={`px-2.5 py-1 rounded-lg ${area.services.water ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                🚰 Agua Potable
              </span>
              <span class={`px-2.5 py-1 rounded-lg ${area.services.dumpGrey ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                🚛 Vaciado Aguas Grises
              </span>
              <span class={`px-2.5 py-1 rounded-lg ${area.services.dumpBlack ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                🚽 Vaciado Aguas Negras
              </span>
              <span class={`px-2.5 py-1 rounded-lg ${area.services.electricity ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                🔌 Toma Eléctrica
              </span>
              <span class={`px-2.5 py-1 rounded-lg ${area.services.wifi ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                📶 Wi-Fi
              </span>
              <span class={`px-2.5 py-1 rounded-lg ${area.services.security ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-400 line-through'}`}>
                🛡️ Vigilancia / Control
              </span>
            </div>
          </div>
        </div>
      ))
    ) : (
      <div class="bg-white rounded-2xl p-8 text-center border border-slate-200">
        <p class="text-slate-600 font-medium">Estamos actualizando las áreas de pernocta verificadas en {provName}. Mientras tanto, te recomendamos consultar los campings oficiales.</p>
      </div>
    )}
  </div>

  <!-- Affiliate Banner: Camper Rental -->
  <div class="mb-10">
    <AffiliateBanner
      type="car_rental"
      url="https://getrentacar.tpx.lv/3TC3lyZZ"
      locationName={provName}
      title={`¿No tienes vehículo camper? Alquila una Autocaravana en ${provName}`}
      description={`Compara ofertas de alquiler de furgonetas camper y autocaravanas con seguro en ${provName}.`}
    />
  </div>

  <!-- Recommended Campings Sidebar/Section -->
  {provCampings.length > 0 && (
    <section class="mb-12 pt-6 border-t border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider block">Alternativa con Todos los Servicios</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900">Campings Recomendados en {provName}</h2>
        </div>
        <a href={`${import.meta.env.BASE_URL}${provincia}/`} class="text-xs font-bold text-emerald-600 hover:underline">
          Ver catálogo completo &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {provCampings.map((c) => (
          <CampingCard camping={c} />
        ))}
      </div>
    </section>
  )}
</Layout>
