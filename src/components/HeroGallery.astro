---
interface Props {
  image_urls?: string[];
  images?: string[];
  name: string;
  municipality?: string;
}

const { image_urls, images, name, municipality = 'Málaga' } = Astro.props;
const rawImages = image_urls && image_urls.length > 0 ? image_urls : images;
const displayImages = rawImages && rawImages.length > 0
  ? rawImages
  : ['https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80'];
---

<div class="relative w-full aspect-[16/9] min-h-[260px] sm:min-h-[360px] max-h-[420px] overflow-hidden rounded-2xl bg-slate-100 shadow-md group" data-hero-gallery>
  <div class="flex w-full h-full overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth" data-hero-gallery-track>
    {displayImages.map((img, idx) => (
      <div class="snap-start shrink-0 w-full h-full relative" data-gallery-slide>
        <img
          src={img}
          alt={`Instalaciones y piscina en ${name}, ${municipality}`}
          width="1200"
          height="675"
          fetchpriority={idx === 0 ? "high" : "auto"}
          loading={idx === 0 ? "eager" : "lazy"}
          class="w-full h-full object-cover"
        />
        <div class="absolute bottom-3 right-3 bg-slate-900/80 text-white text-xs px-3 py-1 rounded-full backdrop-blur-md font-semibold z-10" data-gallery-counter>
          {idx + 1} / {displayImages.length}
        </div>
      </div>
    ))}
  </div>

  <!-- Navigation Buttons (Desktop & Mobile Controls) -->
  {displayImages.length > 1 && (
    <>
      <button
        type="button"
        data-gallery-prev
        aria-label="Imagen anterior"
        class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center transition shadow-lg opacity-80 hover:opacity-100 z-20 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        data-gallery-next
        aria-label="Imagen siguiente"
        class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-slate-900/70 hover:bg-slate-900 text-white flex items-center justify-center transition shadow-lg opacity-80 hover:opacity-100 z-20 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </>
  )}
</div>

<script is:inline>
  (function () {
    function initHeroGallery(container) {
      if (!container || container.getAttribute('data-gallery-inited')) return;
      container.setAttribute('data-gallery-inited', 'true');

      const track = container.querySelector('[data-hero-gallery-track]');
      const prevBtn = container.querySelector('[data-gallery-prev]');
      const nextBtn = container.querySelector('[data-gallery-next]');

      if (!track) return;

      function scrollGallery(direction) {
        const slideWidth = track.clientWidth;
        if (!slideWidth) return;
        track.scrollBy({ left: direction * slideWidth, behavior: 'smooth' });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          scrollGallery(-1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          scrollGallery(1);
        });
      }
    }

    function setupGalleries() {
      document.querySelectorAll('[data-hero-gallery]').forEach(initHeroGallery);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGalleries);
    } else {
      setupGalleries();
    }
  })();
</script>
