---
interface Props {
  image_urls?: string[];
  images?: string[];
  name: string;
  municipality?: string;
}

const { image_urls, images, name, municipality = 'Málaga' } = Astro.props;
const rawImages = image_urls && image_urls.length > 0 ? image_urls : images;
const displayImages = rawImages && rawImages.length > 0
  ? rawImages
  : ['https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80'];
---

<div class="relative w-full aspect-[16/9] min-h-[260px] sm:min-h-[360px] max-h-[420px] overflow-hidden rounded-2xl bg-slate-100 shadow-md">
  <div class="flex w-full h-full overflow-x-auto snap-x snap-mandatory scrollbar-none">
    {displayImages.map((img, idx) => (
      <div class="snap-start shrink-0 w-full h-full relative">
        <img
          src={img}
          alt={`Instalaciones y piscina en ${name}, ${municipality}`}
          width="1200"
          height="675"
          fetchpriority={idx === 0 ? "high" : "auto"}
          loading={idx === 0 ? "eager" : "lazy"}
          class="w-full h-full object-cover"
        />
        <div class="absolute bottom-3 right-3 bg-slate-900/80 text-white text-xs px-3 py-1 rounded-full backdrop-blur-md font-semibold">
          {idx + 1} / {displayImages.length}
        </div>
      </div>
    ))}
  </div>
</div>
