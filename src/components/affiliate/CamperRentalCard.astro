---
interface Props {
  city: string;
  affiliateUrl: string;
}

const { city, affiliateUrl } = Astro.props;
---

<div class="my-8 p-6 bg-slate-900 text-white rounded-2xl shadow-xl border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
  <div class="space-y-2 max-w-xl">
    <span class="inline-block px-3 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-semibold rounded-full uppercase tracking-wider">
      Alquiler Camper & Autocaravanas
    </span>
    <h3 class="text-xl font-bold text-white">¿Planeas tu ruta camper por {city}?</h3>
    <p class="text-slate-300 text-sm">
      Compara precios entre las principales agencias de alquiler con recogida en aeropuerto o estación.
    </p>
  </div>
  <a
    href={affiliateUrl}
    target="_blank"
    rel="sponsored nofollow noopener"
    class="w-full md:w-auto text-center px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm rounded-xl transition-all shadow-lg hover:shadow-emerald-500/20 whitespace-nowrap"
  >
    Buscar Campers en {city} &rarr;
  </a>
</div>
