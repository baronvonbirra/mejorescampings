---
interface Activity {
  title: string;
  image: string;
  price: string;
  url: string;
}

interface Props {
  locationName: string;
  activities: Activity[];
}

const { locationName, activities } = Astro.props;
---

<div class="my-10">
  <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
    <span>🎟️</span> Qué hacer cerca de {locationName}
  </h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {activities.map(act => (
      <a
        href={act.url}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="group border border-gray-100 rounded-xl overflow-hidden bg-white hover:shadow-md transition-shadow flex flex-col"
      >
        <img src={act.image} alt={act.title} class="h-32 w-full object-cover group-hover:scale-105 transition-transform duration-300" />
        <div class="p-3 flex flex-col justify-between flex-grow">
          <h4 class="text-xs font-semibold text-gray-800 line-clamp-2 mb-2 group-hover:text-emerald-600">{act.title}</h4>
          <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-50">
            <span class="text-xs text-gray-400">Desde</span>
            <span class="text-xs font-bold text-emerald-600">{act.price}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
