---
interface Props {
  camperAffiliateUrl?: string;
}

const {
  camperAffiliateUrl = "https://getrentacar.tpx.lv/3TC3lyZZ"
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<section class="relative bg-canvas-main pt-6 pb-12 px-4 sm:px-6 lg:px-8 border-b border-line">
  <div class="max-w-7xl mx-auto">

    <!-- GRID HERO DE 2 COLUMNAS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">

      <!-- COLUMNA 1: TITULAR + PUBLICIDAD / AFILIACIÓN (5 Cols en LG) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">

        <!-- Header del Hero -->
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stoneText-main/5 text-stoneText-main text-xs font-semibold uppercase tracking-wider mb-4 border border-line">
            <span>🗺️</span> Guía de Pernocta y Campings
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-stoneText-main tracking-tight leading-tight">
            Explora Andalucía en Camper o Tienda
          </h1>
          <p class="mt-3 text-sm text-stoneText-muted leading-relaxed">
            Mapa verificado con campings a pie de playa, áreas de pernocta y normativas locales actualizadas.
          </p>
        </div>

        <!-- WIDGET DE PUBLICIDAD / AFILIADO TRAVELPAYOUTS (Bloque destacado) -->
        <div class="p-5 rounded-2xl bg-canvas-card border border-line shadow-sm relative overflow-hidden">
          <div class="absolute top-2 right-3 text-[10px] uppercase font-bold text-stoneText-muted tracking-widest">
            Patrocinado
          </div>
          <div class="flex items-start gap-3 mb-3">
            <span class="text-2xl">🚐</span>
            <div>
              <h3 class="text-sm font-bold text-stoneText-main">¿Necesitas alquilar una Camper?</h3>
              <p class="text-xs text-stoneText-muted">Compara ofertas con entrega en Málaga, Sevilla o Cádiz.</p>
            </div>
          </div>

          <a
            href={camperAffiliateUrl}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="w-full mt-2 inline-flex items-center justify-center px-4 py-2.5 bg-brand-olive hover:bg-brand-olive-hover text-canvas-main font-bold text-xs rounded-xl transition-all shadow-sm"
          >
            Buscar Campers Disponibles →
          </a>
        </div>

        <!-- Indicador de estado/resumen -->
        <div class="flex items-center justify-between text-xs text-stoneText-muted pt-2 border-t border-line">
          <span>📍 +150 Puntos verificados</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Actualizado 2026</span>
        </div>

      </div>

      <!-- COLUMNA 2: MAPA INTERACTIVO (7 Cols en LG) -->
      <div class="lg:col-span-7 relative min-h-[420px] lg:min-h-[520px] rounded-3xl overflow-hidden border border-line shadow-sm bg-canvas-card">

        <!-- BARRA DE FILTROS FLOTANTE SOBRE EL MAPA -->
        <div class="absolute top-4 left-4 right-4 z-[1000] flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="hero-filter-pills">
          <button class="hero-map-filter active bg-stoneText-main text-canvas-main text-xs font-semibold px-3.5 py-1.5 rounded-full shadow-md whitespace-nowrap transition-all cursor-pointer" data-filter="all">
            Todos
          </button>
          <button class="hero-map-filter bg-white/90 backdrop-blur-md text-stoneText-main hover:bg-white text-xs font-semibold px-3.5 py-1.5 rounded-full shadow-md whitespace-nowrap transition-all cursor-pointer" data-filter="beach">
            🏖️ Playa
          </button>
          <button class="hero-map-filter bg-white/90 backdrop-blur-md text-stoneText-main hover:bg-white text-xs font-semibold px-3.5 py-1.5 rounded-full shadow-md whitespace-nowrap transition-all cursor-pointer" data-filter="camper">
            🚐 Pernocta
          </button>
          <button class="hero-map-filter bg-white/90 backdrop-blur-md text-stoneText-main hover:bg-white text-xs font-semibold px-3.5 py-1.5 rounded-full shadow-md whitespace-nowrap transition-all cursor-pointer" data-filter="pets">
            🐶 Mascotas
          </button>
        </div>

        <!-- CONTENEDOR LEAFLET -->
        <div id="hero-map" class="w-full h-full min-h-[420px] lg:min-h-[520px]"></div>

      </div>

    </div>
  </div>
</section>

<!-- Leaflet Assets -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>

<script is:inline define:vars={{ baseUrl }}>
  const initHeroMap = async () => {
    const mapElement = document.getElementById('hero-map');
    if (!mapElement) return;

    // Ensure Leaflet library is loaded
    if (typeof L === 'undefined') {
      await new Promise((resolve) => {
        let attempts = 0;
        const interval = setInterval(() => {
          attempts++;
          if (typeof L !== 'undefined' || attempts > 100) {
            clearInterval(interval);
            resolve();
          }
        }, 50);
      });
    }

    if (typeof L === 'undefined') {
      console.error('Leaflet failed to load for hero map');
      return;
    }

    // Check if map instance is already attached to prevent re-initialization error
    if (mapElement._leaflet_id) {
      return;
    }

    // Estilo CartoDB Voyager (tonos cal/piedra acordes a la paleta)
    const map = L.map('hero-map', {
      scrollWheelZoom: false,
      zoomControl: false
    }).setView([37.2000, -4.5000], 7.5);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    setTimeout(() => {
      map.invalidateSize();
    }, 200);

    const allMarkers = [];

    try {
      const endpointUrl = `${baseUrl.endsWith('/') ? baseUrl : baseUrl + '/'}api/campings-geo.json`;
      const res = await fetch(endpointUrl);
      if (!res.ok) throw new Error(`HTTP error ${res.status}`);
      const campings = await res.json();

      campings.forEach(c => {
        if (c.latitude && c.longitude) {
          const markerIcon = L.divIcon({
            className: 'hero-pin',
            html: `<div class="w-3.5 h-3.5 bg-[#2A4836] border-2 border-white rounded-full shadow-md hover:scale-125 transition-transform"></div>`,
            iconSize: [14, 14]
          });

          const detailHref = `${baseUrl.endsWith('/') ? baseUrl : baseUrl + '/'}camping/${c.slug}/`;

          const popupContent = `
            <div class="p-1 max-w-[190px]">
              <img src="${c.main_image}" alt="${c.name}" class="w-full h-20 object-cover rounded-lg mb-2"/>
              <h4 class="font-bold text-xs text-[#1C1917] leading-tight mb-1">${c.name}</h4>
              <p class="text-[10px] text-[#78716C] mb-2">${c.municipality}</p>
              <a href="${detailHref}" class="block w-full py-1 text-center bg-[#2A4836] text-[#FBF9F5] text-[10px] font-bold rounded hover:bg-[#1F3628] transition-colors">Ver Ficha →</a>
            </div>
          `;

          const marker = L.marker([c.latitude, c.longitude], { icon: markerIcon })
            .addTo(map)
            .bindPopup(popupContent);

          allMarkers.push({
            marker,
            data: c
          });
        }
      });
    } catch (e) {
      console.error("Error cargando puntos del mapa hero:", e);
    }

    // Filter Pills Logic
    const filterButtons = document.querySelectorAll('.hero-map-filter');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update active class styles
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-[#1C1917]', 'text-[#FBF9F5]', 'bg-stoneText-main', 'text-canvas-main');
          b.classList.add('bg-white/90', 'backdrop-blur-md', 'text-[#1C1917]', 'hover:bg-white', 'text-stoneText-main');
        });
        btn.classList.remove('bg-white/90', 'backdrop-blur-md', 'hover:bg-white');
        btn.classList.add('active', 'bg-[#1C1917]', 'text-[#FBF9F5]');

        const activeLatLngs = [];

        // Filter map markers
        allMarkers.forEach(item => {
          const { marker, data } = item;
          const amenities = data.amenities || {};
          let visible = false;

          if (filter === 'all') {
            visible = true;
          } else if (filter === 'beach') {
            visible = !!amenities.beach;
          } else if (filter === 'camper') {
            visible = !!amenities.camper;
          } else if (filter === 'pets') {
            visible = !!amenities.pets;
          }

          if (visible) {
            if (!map.hasLayer(marker)) {
              map.addLayer(marker);
            }
            activeLatLngs.push(marker.getLatLng());
          } else {
            if (map.hasLayer(marker)) {
              map.removeLayer(marker);
            }
          }
        });

        if (activeLatLngs.length > 0) {
          map.fitBounds(L.latLngBounds(activeLatLngs), { padding: [30, 30] });
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroMap);
  } else {
    initHeroMap();
  }
  document.addEventListener('astro:page-load', initHeroMap);
</script>
