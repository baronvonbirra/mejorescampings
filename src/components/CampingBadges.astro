---
interface Props {
  amenities?: Record<string, boolean> | string[];
  provinceSlug?: string;
}

const { amenities = {}, provinceSlug = 'malaga' } = Astro.props;

const amenitiesDict: Record<string, boolean> = Array.isArray(amenities)
  ? amenities.reduce((acc, curr) => ({ ...acc, [curr]: true }), {})
  : (amenities || {});

const badgeConfig = [
  { key: 'piscina', label: 'Piscina', icon: '🏊', slug: 'campings-con-piscina' },
  { key: 'mascotas', label: 'Mascotas Permitidas', icon: '🐶', slug: 'campings-con-mascotas' },
  { key: 'animacion_infantil', label: 'Animación Infantil', icon: '✨', slug: 'campings-con-animacion-infantil' },
  { key: 'entorno_familiar', label: 'Familiar', icon: '👨‍👩‍👧‍👦', slug: 'campings-familiares' },
  { key: 'glamping', label: 'Glamping / Cabañas', icon: '⛺', slug: 'campings-bungalows' },
  { key: 'playa', label: 'Cerca de Playa', icon: '🏖️', slug: 'campings-playa' },
  { key: 'montana', label: 'En la Montaña', icon: '🏔️', slug: 'campings-montana' },
  { key: 'wifi', label: 'Wi-Fi Gratis', icon: '📶', slug: '' },
  { key: 'electricidad', label: 'Toma Eléctrica / Camper', icon: '⚡', slug: '' }
];

// Always display badges for active amenities or fallback list if empty
const activeBadges = badgeConfig.filter(b => amenitiesDict[b.key]);
const displayBadges = activeBadges.length > 0 ? activeBadges : badgeConfig.slice(0, 4);

const cleanProvince = provinceSlug ? provinceSlug.toLowerCase() : 'malaga';
---

<div class="flex flex-wrap gap-2.5 my-3">
  {displayBadges.map((badge) => {
    const filterUrl = badge.slug ? `${import.meta.env.BASE_URL}${cleanProvince}/${badge.slug}/` : null;
    return filterUrl ? (
      <a
        href={filterUrl}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200/80 text-emerald-900 font-bold text-xs shadow-2xs transition group"
      >
        <span class="text-sm">{badge.icon}</span>
        <span class="group-hover:underline">{badge.label}</span>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-900 font-bold text-xs shadow-2xs">
        <span class="text-sm">{badge.icon}</span>
        <span>{badge.label}</span>
      </span>
    );
  })}
</div>
