---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  url: string;
  badge?: string;
}

const { title, description, buttonText, url, badge = "Recomendado" } = Astro.props;
---

<div class="my-8 p-6 bg-emerald-50 border border-emerald-200 rounded-xl shadow-sm">
  <div class="flex items-center justify-between mb-2">
    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">{badge}</span>
  </div>
  <h4 class="text-lg font-bold text-gray-900 mb-1">{title}</h4>
  <p class="text-gray-600 text-sm mb-4">{description}</p>
  <a
    href={url}
    target="_blank"
    rel="sponsored nofollow"
    class="inline-block bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm px-5 py-2.5 rounded-lg transition-colors"
  >
    {buttonText} →
  </a>
</div>
