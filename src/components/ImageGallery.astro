---
interface Props {
  images: string[];
  name: string;
}

const { images = [], name } = Astro.props;
const displayImages = images.length > 0 ? images : ['https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80'];
---

<div class="relative w-full overflow-hidden rounded-xl bg-slate-100 group shadow-md">
  <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none h-64 sm:h-80 md:h-96">
    {displayImages.map((img, idx) => (
      <div class="snap-start shrink-0 w-full h-full relative">
        <img
          src={img}
          alt={`${name} - Foto ${idx + 1}`}
          class="w-full h-full object-cover"
          loading={idx === 0 ? "eager" : "lazy"}
        />
        <div class="absolute bottom-3 right-3 bg-slate-900/75 text-white text-xs px-2.5 py-1 rounded-full backdrop-blur-xs">
          {idx + 1} / {displayImages.length}
        </div>
      </div>
    ))}
  </div>
</div>
