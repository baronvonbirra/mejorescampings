---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = 'MejoresCampings - Encuentra los mejores campings y glampings en Andalucía y España.', image, noindex = false } = Astro.props;
const ogImageUrl = image || 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80';
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="twSOWF6MuHCrN5SBMKhYQZJ9FRm1Swt2VTxmpVl7KVc" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} | MejoresCampings.es</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OpenGraph Social Preview Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3662347870044736" crossorigin="anonymous"></script>

    <!-- Travelpayouts script -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://tp-em.com/NTY5NTkx.js?t=569591';
          document.head.appendChild(script);
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen pb-20 md:pb-0">
    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 font-black text-2xl tracking-tight text-emerald-600">
          <svg class="w-8 h-8 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 22h20L12 2zm0 4.2L18.6 19H5.4L12 6.2z"/>
          </svg>
          MejoresCampings
        </a>
        <nav class="hidden sm:flex gap-6 text-sm font-medium text-slate-600">
          <a href={`${import.meta.env.BASE_URL}guias/`} class="hover:text-emerald-600 font-bold text-emerald-700 transition">Guías Pernocta</a>
          <a href={`${import.meta.env.BASE_URL}malaga/`} class="hover:text-emerald-600 transition">Málaga</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-con-mascotas/`} class="hover:text-emerald-600 transition">Mascotas OK</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-con-piscina/`} class="hover:text-emerald-600 transition">Con Piscina</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-playa/`} class="hover:text-emerald-600 transition">Playa</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-bungalows/`} class="hover:text-emerald-600 transition">Glamping</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
