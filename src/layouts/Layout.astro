---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = 'MejoresCampings - Encuentra los mejores campings y glampings en Andalucía y España.', image, noindex = false } = Astro.props;
const ogImageUrl = image || 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80';
const canonicalUrl = new URL(Astro.url.pathname, 'https://mejorescampings.es').href;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-[#FAF9F6] text-[#1C1917] font-sans antialiased selection:bg-stone-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="twSOWF6MuHCrN5SBMKhYQZJ9FRm1Swt2VTxmpVl7KVc" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} | MejoresCampings.es</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- OpenGraph Social Preview Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3662347870044736" crossorigin="anonymous"></script>

    <!-- Travelpayouts script -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://tp-em.com/NTY5NTkx.js?t=569591';
          document.head.appendChild(script);
      })();
    </script>

    <!-- Astro ClientRouter for seamless page transitions -->
    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen pb-20 md:pb-0 bg-[#FAF9F6] text-[#1C1917]">
    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-[#FAF9F6]/90 backdrop-blur-md border-b border-stone-200/80 shadow-2xs transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2.5 font-serif text-2xl font-bold tracking-tight text-[#1C1917] hover:text-[#2D4A3E] transition-colors">
          <svg class="w-7 h-7 text-[#2D4A3E]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 22h20L12 2zm0 4.2L18.6 19H5.4L12 6.2z"/>
          </svg>
          <span class="tracking-tight">MejoresCampings</span>
        </a>
        <nav class="hidden sm:flex items-center gap-6 text-xs font-semibold uppercase tracking-wider text-stone-600">
          <a href={`${import.meta.env.BASE_URL}mapa/`} class="hover:text-[#2D4A3E] transition-colors flex items-center gap-1 font-bold text-stone-900">
            <span class="inline-block w-2 h-2 rounded-full bg-[#2D4A3E]"></span>
            Mapa Split
          </a>
          <a href={`${import.meta.env.BASE_URL}guias/`} class="hover:text-[#2D4A3E] transition-colors">Guías Pernocta</a>
          <a href={`${import.meta.env.BASE_URL}areas-ac/`} class="hover:text-[#2D4A3E] transition-colors">Áreas AC</a>
          <a href={`${import.meta.env.BASE_URL}cerca-de/`} class="hover:text-[#2D4A3E] transition-colors">Parques Naturales</a>
          <a href={`${import.meta.env.BASE_URL}malaga/`} class="hover:text-[#2D4A3E] transition-colors">Málaga</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-con-mascotas/`} class="hover:text-[#2D4A3E] transition-colors">Mascotas OK</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-con-piscina/`} class="hover:text-[#2D4A3E] transition-colors">Con Piscina</a>
          <a href={`${import.meta.env.BASE_URL}malaga/campings-playa/`} class="hover:text-[#2D4A3E] transition-colors">Playa</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
