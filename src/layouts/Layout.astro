---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'CampBase - Encuentra los mejores campings y glampings en Andalucía y España.', image } = Astro.props;
const ogImageUrl = image || 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80';
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="twSOWF6MuHCrN5SBMKhYQZJ9FRm1Swt2VTxmpVl7KVc" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} | CampBase.es</title>
    <meta name="description" content={description} />

    <!-- OpenGraph Social Preview Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Travelpayouts script -->
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://tp-em.com/NTY2NDY4.js?t=566468';
          document.head.appendChild(script);
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen pb-20 md:pb-0">
    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 font-black text-2xl tracking-tight text-emerald-600">
          <svg class="w-8 h-8 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 22h20L12 2zm0 4.2L18.6 19H5.4L12 6.2z"/>
          </svg>
          CampBase<span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 ml-1">Málaga MVP</span>
        </a>
        <nav class="hidden sm:flex gap-6 text-sm font-medium text-slate-600">
          <a href={`${import.meta.env.BASE_URL}andalucia/malaga/`} class="hover:text-emerald-600 transition">Málaga</a>
          <a href={`${import.meta.env.BASE_URL}andalucia/malaga/campings-con-piscina/`} class="hover:text-emerald-600 transition">Con Piscina</a>
          <a href={`${import.meta.env.BASE_URL}andalucia/malaga/campings-familiares/`} class="hover:text-emerald-600 transition">Familiares</a>
          <a href={`${import.meta.env.BASE_URL}andalucia/malaga/glamping/`} class="hover:text-emerald-600 transition">Glamping</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-10 mt-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <span class="font-bold text-lg text-white">CampBase.es</span>
          <p class="mt-2 text-sm text-slate-400">Guía especializada en alojamiento de naturaleza, campings y glampings en Andalucía.</p>
        </div>
        <div>
          <h4 class="font-semibold text-white text-sm uppercase tracking-wider">Destinos Populares</h4>
          <ul class="mt-2 space-y-1 text-sm">
            <li><a href={`${import.meta.env.BASE_URL}andalucia/malaga/`} class="hover:text-white">Campings en Málaga</a></li>
            <li><a href={`${import.meta.env.BASE_URL}andalucia/malaga/campings-con-piscina/`} class="hover:text-white">Campings con Piscina Málaga</a></li>
            <li><a href={`${import.meta.env.BASE_URL}andalucia/malaga/campings-con-animacion-infantil/`} class="hover:text-white">Animación Infantil Málaga</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-semibold text-white text-sm uppercase tracking-wider">Aviso Legal & Afiliación</h4>
          <p class="mt-2 text-xs text-slate-500">CampBase participa en programas de afiliación. Al reservar a través de nuestros enlaces, podemos recibir una comisión sin coste adicional para ti.</p>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-6 border-t border-slate-800 text-xs text-center text-slate-500">
        &copy; {new Date().getFullYear()} CampBase.es - Todos los derechos reservados.
      </div>
    </footer>
  </body>
</html>
